// ============================================================
// PIK — Persistent Identity Kernel
// Prisma Schema for PostgreSQL (Railway)
// Sprint 6A: FateAccount layer added above RootIdentity
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// FATE ACCOUNTS — Top-level credential layer
// One FateAccount → many Heroes (RootIdentity, max 2)
// Auth: email+password | google | apple
// ============================================================

model FateAccount {
  id           String    @id @default(uuid()) @map("account_id")
  email        String?   @unique                          
  provider     String    @default("email")
  providerId   String?   @map("provider_id")
  passwordHash String?   @map("password_hash")
  displayName  String?   @map("display_name")
  status       String    @default("active")
  createdAt    DateTime  @default(now()) @map("created_at")
  lastLoginAt  DateTime? @map("last_login_at")

  heroes       RootIdentity[]
  sessions     AccountSession[]

  @@index([email])
  @@unique([provider, providerId])                        
  @@map("fate_accounts")
}

model AccountSession {
  id              String    @id @default(uuid()) @map("session_id")
  accountId       String    @map("account_id")
  tokenHash       String    @unique @map("token_hash")     // SHA-256 of raw token
  selectedHeroId  String?   @map("selected_hero_id")       // null = at hero select, set after hero chosen
  expiresAt       DateTime  @map("expires_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  account         FateAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  hero            RootIdentity? @relation(fields: [selectedHeroId], references: [id], onDelete: SetNull)

  @@index([tokenHash])
  @@index([accountId])
  @@map("account_sessions")
}

// ============================================================
// IDENTITY KERNEL — Hero records (one per character slot)
// Now owned by a FateAccount. Max 2 per account enforced in service.
// ============================================================

model RootIdentity {
  id            String    @id @default(uuid()) @map("root_id")
  fateAccountId String?   @map("fate_account_id")   // FK to FateAccount (nullable for legacy)
  heroName      String    @unique @map("hero_name")
  fateAlignment String    @default("NONE") @map("fate_alignment")
  origin        String?
  // Sprint 28 — single Fate XP per docs/canon/progression.md.
  // Drives Adventurer Rank and all content gates; combat power is
  // Resonance (gear-derived, computed, see § 3 of the canon).
  fateXp        Int       @default(0) @map("fate_xp")
  fateLevel     Int       @default(1) @map("fate_level")
  // Sprint 22.C — Job Class (selected at level 40, null until then)
  heroClass     String?   @map("hero_class")
  enrolledBy    String    @default("self") @map("enrolled_by")
  enrolledAt    DateTime  @default(now()) @map("enrolled_at")
  status        String    @default("active")
  equippedTitle String?   @map("equipped_title")
  // Sprint 31 — Reliquary Mark (Tier 2 cosmetic evolution). The
  // Reliquary is canon-universal (every hero wears one — economy.md
  // § 2). Mark is the player's first cosmetic-as-identity hook on
  // it. NULL = unmarked (default "plain-bound" silver). Validated
  // server-side against a known-Mark allowlist.
  relicMark     String?   @map("relic_mark")
  // Sprint 28 — Awakening narrative profile
  region                String?
  wound                 String?
  calling               String?
  virtue                String?
  vice                  String?
  // Sprint 33 — Character Creation appearance (streamed-scene selection:
  // { gender, ancestry, region, kit, hairstyle }). Drives the Profile portrait.
  appearance            Json?
  awakeningCompletedAt  DateTime? @map("awakening_completed_at")
  // Sprint 28 — Expo push token (single token per hero in v1.0;
  // multi-device support is a separate push_devices table later).
  pushToken             String?   @map("push_token")
  pushUpdatedAt         DateTime? @map("push_updated_at")

  // Relations
  fateAccount   FateAccount?    @relation(fields: [fateAccountId], references: [id], onDelete: Cascade)
  activeSessions AccountSession[]
  personas      Persona[]
  keys          AuthKey[]
  sourceLinks   SourceLink[]
  events        IdentityEvent[]
  titles        UserTitle[]
  fateMarkers   FateMarker[]
  fateCaches    FateCache[]
  inventory     PlayerInventory[]
  equipment     PlayerEquipment[]
  challenges    WebAuthnChallenge[]
  sessions      PlayerSession[]
  wearables     IdentityToken[]
  quests        PlayerQuest[]
  dailyRites    DailyRite[]
  trainingEntries TrainingEntry[]
  pillarProgress  PillarProgress[]
  oaths           Oath[]
  nexus           PlayerNexus?
  components      PlayerComponents[]
  veilShards      VeilShard?
  tearEncounters  TearEncounter[]
  pityCounters      PityCounter[]
  warbandMemberships WarbandMembership[]
  sentInvites        WarbandInvite[]     @relation("InviteSender")
  foundedWarbands    Warband[]
  convergenceContributions ConvergenceContribution[]
  landmarkDiscoveries      LandmarkDiscovery[]         // Sprint 25
  sanctumState             SanctumState?               // Sprint 28 — iOS daily ritual
  iapPurchases             IapPurchase[]               // Sprint 28 — iOS IAP transactions
  fateFox                  FateFox?                    // Sprint 31 — Fate Fox companion (one per hero)
  memoria                  PlayerMemoria[]             // Sprint 32 — Memoria identity-collection
  sealedTears              WorldTear[]                 // Sprint 29 — Arc B geo-aware rifts
  loreFinds                HeroLore[]                  // 2026-07-06 — Lore Archive collection
  runSeats                 RunParticipant[]            // HEP Phase 2 Slice 1 — venue experience runs

  @@index([fateAccountId])
  @@map("root_identities")
}

model Persona {
  id            String    @id @default(uuid()) @map("persona_id")
  rootId        String    @map("root_id")
  displayName   String    @map("display_name")
  metadata      Json?
  status        String    @default("active")
  createdAt     DateTime  @default(now()) @map("created_at")

  root          RootIdentity @relation(fields: [rootId], references: [id], onDelete: Cascade)

  @@index([rootId])
  @@map("personas")
}

// ============================================================
// AUTHENTICATION — Legacy WebAuthn (retained, not used by Codex PWA)
// ============================================================

model AuthKey {
  id              String    @id @default(uuid()) @map("key_id")
  rootId          String    @map("root_id")
  credentialId    String    @unique @map("credential_id")
  publicKey       Bytes     @map("public_key")
  counter         BigInt    @default(0)
  deviceType      String?   @map("device_type")
  backedUp        Boolean   @default(false)
  transports      String[]  @default([])
  friendlyName    String?   @map("friendly_name")
  status          String    @default("active")
  createdAt       DateTime  @default(now()) @map("created_at")
  revokedAt       DateTime? @map("revoked_at")
  lastUsedAt      DateTime? @map("last_used_at")

  root            RootIdentity @relation(fields: [rootId], references: [id], onDelete: Cascade)

  @@index([rootId, status])
  @@map("auth_keys")
}

model WebAuthnChallenge {
  id          String    @id @default(uuid())
  rootId      String?   @map("root_id")
  challenge   String    @unique
  type        String
  metadata    Json?
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  root        RootIdentity? @relation(fields: [rootId], references: [id], onDelete: Cascade)

  @@index([challenge])
  @@index([expiresAt])
  @@map("webauthn_challenges")
}

// Legacy session tokens — kept for operator impersonation compatibility
model SessionToken {
  id          String    @id @default(uuid()) @map("token_id")
  rootId      String    @map("root_id")
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([tokenHash])
  @@index([expiresAt])
  @@map("session_tokens")
}

// ============================================================
// WEARABLE BRIDGE
// ============================================================

model IdentityToken {
  id          String    @id @default(uuid()) @map("token_id")
  rootId      String    @map("root_id")
  tokenType   String    @map("token_type")
  tokenUid    String    @unique @map("token_uid")
  friendlyName String?  @map("friendly_name")
  status      String    @default("active")
  issuedAt    DateTime  @default(now()) @map("issued_at")
  expiresAt   DateTime? @map("expires_at")
  lastTapAt   DateTime? @map("last_tap_at")
  tapCount    Int       @default(0) @map("tap_count")
  metadata    Json?

  root        RootIdentity @relation(fields: [rootId], references: [id], onDelete: Cascade)

  @@index([rootId])
  @@index([status])
  @@map("identity_tokens")
}

// ============================================================
// CONSENT — Sources and source links
// ============================================================

model Source {
  id          String    @id @map("source_id")
  name        String    @map("source_name")
  apiKeyHash  String    @map("api_key_hash")
  status      String    @default("active")
  sourceType  String    @default("venue") @map("source_type")
  createdAt   DateTime  @default(now()) @map("created_at")

  /// Partner-level capability ceiling (space-delimited, same vocabulary as
  /// SourceLink.scope). A partner can never write outside these, even if a
  /// player's consent grant is broader — the effective scope is the
  /// intersection of the two. Defaults to the full progression set so
  /// existing venues keep working after the Phase 2 Slice 0 migration.
  scopes      String    @default("xp fate_markers titles")

  /// Venue-editable descriptive fields (contact, address, hours, timezone,
  /// geo). Deliberately separate from `scopes` and `status`, which are the
  /// commercial terms of the partnership and belong to Heroes — a venue
  /// editing its own scopes would be self-granting.
  profile     Json      @default("{}")

  sourceLinks SourceLink[]
  fateCaches  FateCache[]
  ingestReceipts IngestReceipt[]
  venueExperiences VenueExperience[]
  experienceRuns   ExperienceRun[]
  staff            VenueStaff[]
  auditEntries     VenueAuditEntry[]
  rooms            VenueRoom[]
  spatialMetrics   SpatialMetric[]

  @@map("sources")
}

// ════════════════════════════════════════════════════════════════════════
// HEP Phase 2 Slice 2 — venue staff identity
//
// Onboarding previously required a Heroes engineer running curl with the
// shared HV_PLATFORM_ADMIN_KEY, which has no tenant scoping and therefore
// can never be handed to a partner. These tables are what let a venue's
// own people log in, scoped to their venue and their role.
// ════════════════════════════════════════════════════════════════════════

/// A person at one venue.
model VenueStaff {
  id           String    @id @default(uuid()) @map("staff_id")
  sourceId     String    @map("source_id")
  email        String
  /// Null while status = 'invited' — set when the invite is accepted.
  passwordHash String?   @map("password_hash")
  displayName  String?   @map("display_name")
  /// owner | manager | operator | viewer — see src/portal/roles.ts
  role         String    @default("viewer")
  /// active | invited | suspended
  status       String    @default("invited")
  /// "staff:<id>" of the inviter, or "platform" for the founding owner.
  invitedBy    String?   @map("invited_by")
  /// Single-use invite credential, hashed. Cleared once accepted.
  inviteHash   String?   @unique @map("invite_hash")
  inviteExpires DateTime? @map("invite_expires")

  /// Single-use password-reset credential, hashed. Cleared once used.
  ///
  /// Deliberately NOT reusing inviteHash. The two are disjoint today only
  /// because acceptInvite requires status='invited' while reset requires
  /// status='active' — one shared column would make that check the only
  /// thing standing between an unaccepted invite token and a password
  /// reset on a live account. Two columns cost one additive migration and
  /// remove the question.
  resetHash    String?   @unique @map("reset_hash")
  resetExpires DateTime? @map("reset_expires")
  /// Throttles resend, so /auth/forgot cannot be used to mailbomb a member.
  resetRequestedAt DateTime? @map("reset_requested_at")

  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  source   Source              @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sessions VenueStaffSession[]
  audit    VenueAuditEntry[]

  /// Scoped, not global: a regional manager may legitimately hold an
  /// account at several venues, and each is a separate grant.
  @@unique([sourceId, email])
  @@index([sourceId, status])
  @@map("venue_staff")
}

/// Opaque bearer token for a signed-in staff member. Mirrors the
/// AccountSession pattern — random bytes, stored only as a SHA-256 digest.
model VenueStaffSession {
  id        String   @id @default(uuid()) @map("session_id")
  staffId   String   @map("staff_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  staff VenueStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@map("venue_staff_sessions")
}

/// Who did what, per venue.
///
/// Deliberately NOT IdentityEvent: that ledger is keyed on rootId (a hero),
/// and staff actions are not hero-scoped. Forcing them in would pollute a
/// player's chronicle with venue administration noise.
model VenueAuditEntry {
  id        String   @id @default(uuid()) @map("entry_id")
  sourceId  String   @map("source_id")
  /// Null for platform-staff actions taken on the venue's behalf.
  staffId   String?  @map("staff_id")
  action    String
  target    String?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  source Source      @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  staff  VenueStaff? @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([sourceId, createdAt])
  @@index([staffId])
  @@map("venue_audit_entries")
}

// ════════════════════════════════════════════════════════════════════════
// HEP Phase 2 Slice 1 — venue experience runs
//
// Additive only: nothing below changes existing Codex behavior. A venue is
// a source of events into the kernel, exactly as /api/ingest already is.
// ════════════════════════════════════════════════════════════════════════

/// A canonical, Heroes-authored experience. Partners configure which of these
/// they may run; they never author one (Phase 2 brief: "Canonical Experiences").
model Experience {
  id                String   @id @default(uuid()) @map("experience_id")
  slug              String   @unique
  name              String
  description       String?
  /// Bumped when the reward bundle or content changes. Copied onto each run so
  /// analytics stay attributable after a revision.
  version           Int      @default(1)
  minPlayers        Int      @default(1) @map("min_players")
  maxPlayers        Int      @default(6) @map("max_players")
  targetDurationSec Int      @default(1200) @map("target_duration_sec")
  /// Reward bundle AND its scaling constants. Deliberately data, not code:
  /// retuning payouts is a DB edit, never a deploy. See docs/hep/slice-1-scope.md §3/§4.
  rewards           Json     @default("{}")

  /// Spatial requirements — what this experience needs from a room
  /// (Workstream 4): requiredAnchors, requiredZones, clearance, player
  /// counts, room profile. Empty for a non-spatial experience, which is
  /// every experience today.
  ///
  /// Data, not code, exactly as `rewards` is: a partner revising a
  /// placement must not need a deploy.
  manifest          Json     @default("{}")
  /// Schema version of `manifest` itself, NOT of the experience.
  ///
  /// The spec versions the experience but not the schema an external team
  /// builds against — and Tier C is partnered out, so their client will
  /// be written months before it is integrated. Without this we cannot
  /// evolve the manifest without breaking a client we do not control.
  manifestSchemaVersion Int  @default(1) @map("manifest_schema_version")

  status            String   @default("active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  venueAssignments VenueExperience[]
  runs             ExperienceRun[]

  @@map("experiences")
}

/// Which venues may run which experiences, and when (Partner Portal's
/// "Experience Assignment" / "Schedule content availability").
model VenueExperience {
  id             String    @id @default(uuid()) @map("venue_experience_id")
  sourceId       String    @map("source_id")
  experienceId   String    @map("experience_id")
  enabled        Boolean   @default(true)
  availableFrom  DateTime? @map("available_from")
  availableUntil DateTime? @map("available_until")
  createdAt      DateTime  @default(now()) @map("created_at")

  source     Source     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, experienceId])
  @@index([sourceId, enabled])
  @@map("venue_experiences")
}

/// One party's playthrough — the entity the brief's analytics are all measured
/// against (completion rate, session duration, technical failures). A party
/// completes or fails together; rewards land per participant.
model ExperienceRun {
  id                String   @id @default(uuid()) @map("run_id")
  sourceId          String   @map("source_id")
  experienceId      String   @map("experience_id")
  experienceVersion Int      @map("experience_version")
  /// Partner-supplied idempotency key for the run (their own session id).
  partnerRunKey     String   @map("partner_run_key")
  /// active | completed | failed | abandoned
  status            String   @default("active")
  startedAt         DateTime @default(now()) @map("started_at")
  lastHeartbeat     DateTime @default(now()) @map("last_heartbeat")
  endedAt           DateTime? @map("ended_at")
  durationSec       Int?     @map("duration_sec")
  /// Milestone timestamps the venue runtime reports; drives the payout bonus.
  milestonesHit     Int      @default(0) @map("milestones_hit")
  /// Computed payout multiplier, persisted so a retune cannot rewrite history.
  payoutMultiplier  Float?   @map("payout_multiplier")
  failureReason     String?  @map("failure_reason")
  outcome           Json?

  source       Source           @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  experience   Experience       @relation(fields: [experienceId], references: [id])
  participants RunParticipant[]
  spatialMetrics SpatialMetric[]

  @@unique([sourceId, partnerRunKey])
  @@index([sourceId, status])
  @@index([experienceId, startedAt])
  @@index([status, lastHeartbeat])
  @@map("experience_runs")
}

/// One seat in a run — either an identified Codex hero or an anonymous guest.
///
/// `rootId` being nullable is the entire concession the model makes for
/// walk-ins, and it is what lets all three arrival paths (existing player,
/// guest, on-site enrollment) share one mechanism.
model RunParticipant {
  id          String   @id @default(uuid()) @map("participant_id")
  runId       String   @map("run_id")
  /// Null for a guest seat until (and unless) a claim binds it to a hero.
  rootId      String?  @map("root_id")
  /// Venue-facing label for an unidentified seat ("Player 3", a wristband id).
  guestLabel  String?  @map("guest_label")
  sessionId   String?  @map("session_id")
  role        String?
  /// The computed bundle for this seat. Held here while pending so a guest's
  /// rewards survive until they create an account.
  rewards     Json     @default("{}")
  /// applied | pending | expired | skipped
  rewardState String   @default("pending") @map("reward_state")
  appliedAt   DateTime? @map("applied_at")
  joinedAt    DateTime @default(now()) @map("joined_at")

  run   ExperienceRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  root  RootIdentity? @relation(fields: [rootId], references: [id], onDelete: Cascade)
  claim GuestClaim?

  @@unique([runId, rootId])
  @@index([runId])
  @@index([rootId])
  @@map("run_participants")
}

/// Rewards earned by a guest seat, waiting for an account to land on.
///
/// The token is stored hashed and never at rest in plaintext — same pattern as
/// source API keys and account sessions. claims ÷ guest seats is the per-venue
/// walk-in conversion rate, which is the strongest evidence available for the
/// brief's business-validation criterion.
model GuestClaim {
  id            String    @id @default(uuid()) @map("claim_id")
  participantId String    @unique @map("participant_id")
  /// Long random token — what the QR encodes. 32 bytes, base64url.
  tokenHash     String    @unique @map("token_hash")
  /// Short human-typable code (e.g. K7QM-4PXR) for when the scan fails.
  /// Hashed like the token; a receipt is not a secret store.
  shortCodeHash String?   @unique @map("short_code_hash")
  sourceId      String    @map("source_id")
  /// pending | claimed | expired
  status        String    @default("pending")
  expiresAt     DateTime  @map("expires_at")
  claimedAt     DateTime? @map("claimed_at")
  claimedBy     String?   @map("claimed_by_root_id")
  createdAt     DateTime  @default(now()) @map("created_at")

  participant RunParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([sourceId, status])
  @@index([status, expiresAt])
  @@map("guest_claims")
}

/// Idempotency ledger for the Partner Integration API.
///
/// Venue hardware retries on flaky networks; without this a replayed
/// `POST /api/ingest` double-grants XP and loot. The partner supplies a
/// stable `event_id` per real-world occurrence, and a replay returns the
/// original response verbatim instead of re-applying the rewards.
///
/// Mirrors the IAP transactionId dedup pattern (src/iap/iap.service.ts).
model IngestReceipt {
  id         String   @id @default(uuid()) @map("receipt_id")
  sourceId   String   @map("source_id")
  /// Partner-supplied idempotency key, unique within that partner.
  eventKey   String   @map("event_key")
  rootId     String   @map("root_id")
  eventType  String   @map("event_type")
  /// "processing" while the first request is still applying rewards,
  /// "completed" once the response is stored. A retry that arrives during
  /// "processing" is rejected with 409 rather than racing the original.
  status     String   @default("processing")
  /// The full response body returned the first time, replayed on retry.
  response   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  source     Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, eventKey])
  @@index([rootId, createdAt])
  @@map("ingest_receipts")
}

model SourceLink {
  id          String    @id @default(uuid()) @map("link_id")
  rootId      String    @map("root_id")
  sourceId    String    @map("source_id")
  scope       String    @default("xp fate_markers titles")
  grantedBy   String    @map("granted_by")
  grantedAt   DateTime  @default(now()) @map("granted_at")
  revokedAt   DateTime? @map("revoked_at")
  revokedBy   String?   @map("revoked_by")
  status      String    @default("active")

  root        RootIdentity @relation(fields: [rootId], references: [id], onDelete: Cascade)
  source      Source       @relation(fields: [sourceId], references: [id])

  @@index([rootId, sourceId, status])
  @@map("source_links")
}

// ============================================================
// EVENT LEDGER — Append-only
// ============================================================

model IdentityEvent {
  id          String    @id @default(uuid()) @map("event_id")
  rootId      String    @map("root_id")
  eventType   String    @map("event_type")
  sourceId    String?   @map("source_id")
  payload     Json      @default("{}")
  changes     Json?     @map("changes_applied")
  createdAt   DateTime  @default(now()) @map("created_at")

  root        RootIdentity @relation(fields: [rootId], references: [id], onDelete: Cascade)

  @@index([rootId, createdAt])
  @@index([eventType])
  @@index([sourceId])
  @@map("identity_events")
}

// ============================================================
// PROGRESSION
// ============================================================

model Title {
  id            String    @id @map("title_id")
  displayName   String    @map("display_name")
  description   String?
  category      String?

  userTitles    UserTitle[]

  @@map("titles")
}

model UserTitle {
  id          String    @id @default(uuid())
  rootId      String    @map("root_id")
  titleId     String    @map("title_id")
  grantedAt   DateTime  @default(now()) @map("granted_at")
  sourceId    String?   @map("source_id")

  root        RootIdentity @relation(fields: [rootId], references: [id], onDelete: Cascade)
  title       Title        @relation(fields: [titleId], references: [id])

  @@unique([rootId, titleId])
  @@map("user_titles")
}

model FateMarker {
  id          String    @id @default(uuid())
  rootId      String    @map("root_id")
  marker      String
  sourceId    String?   @map("source_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  root        RootIdentity @relation(fields: [rootId], references: [id], onDelete: Cascade)

  @@index([rootId])
  @@map("fate_markers")
}

// ============================================================
// LOOT SYSTEM
// ============================================================

model LootTable {
  id          String  @id @default(uuid()) @map("loot_table_id")
  cacheType   String  @map("cache_type")
  rewardType  String  @map("reward_type")
  rewardValue String  @map("reward_value")
  displayName String  @map("display_name")
  weight      Int     @default(100)
  rarityTier  String  @default("common") @map("rarity_tier")
  minLevel    Int     @default(1) @map("min_level")

  @@index([cacheType])
  @@map("loot_table")
}

model FateCache {
  id           String    @id @default(uuid()) @map("cache_id")
  rootId       String    @map("root_id")
  cacheType    String    @map("cache_type")
  rarity       String    @default("common")
  sourceId     String?   @map("source_id")
  trigger      String?
  status       String    @default("sealed")
  grantedAt    DateTime  @default(now()) @map("granted_at")
  openedAt     DateTime? @map("opened_at")
  rewardType   String?   @map("reward_type")
  rewardValue  String?   @map("reward_value")
  rewardName   String?   @map("reward_name")
  rewardRarity String?   @map("reward_rarity")

  root   RootIdentity @relation(fields: [rootId], references: [id], onDelete: Cascade)
  source Source?      @relation(fields: [sourceId], references: [id])

  @@index([rootId])
  @@index([rootId, status])
  @@map("fate_caches")
}

// ============================================================
// GEAR SYSTEM
// ============================================================

model GearItem {
  id          String   @id @map("item_id")
  name        String   @map("display_name")
  slot        String
  rarityTier  String   @default("common") @map("rarity_tier")
  description String?
  loreText    String?  @map("lore_text")
  icon        String   @default("⚔")
  minLevel    Int      @default(1) @map("min_level")
  modifiers   Json     @default("{}")
  // Loot Sprint B — Phase 1 + 2A fields
  levelBand   String?  @map("level_band")
  regionTheme String?  @map("region_theme")
  itemFamily  String?  @map("item_family")
  loreTags    String[] @default([]) @map("lore_tags")
  itemPower   Int?     @map("item_power")
  slotBudget  Int?     @map("slot_budget")
  baseItemId  String?  @map("base_item_id")

  inventory   PlayerInventory[]

  @@index([slot])
  @@index([rarityTier])
  @@index([levelBand])
  @@index([regionTheme])
  @@map("gear_items")
}

model PlayerInventory {
  id          String    @id @default(uuid()) @map("inventory_id")
  rootId      String    @map("root_id")
  itemId      String    @map("item_id")
  acquiredVia String    @default("cache") @map("acquired_via")
  acquiredAt  DateTime  @default(now()) @map("acquired_at")

  root        RootIdentity   @relation(fields: [rootId], references: [id], onDelete: Cascade)
  item        GearItem       @relation(fields: [itemId], references: [id])
  equipment   PlayerEquipment?

  @@index([rootId])
  @@map("player_inventory")
}

model PlayerEquipment {
  id          String    @id @default(uuid()) @map("equipment_id")
  rootId      String    @map("root_id")
  slot        String
  inventoryId String    @unique @map("inventory_id")
  equippedAt  DateTime  @default(now()) @map("equipped_at")

  root        RootIdentity    @relation(fields: [rootId], references: [id], onDelete: Cascade)
  inventory   PlayerInventory @relation(fields: [inventoryId], references: [id])

  @@unique([rootId, slot])
  @@map("player_equipment")
}

// ============================================================
// SESSIONS
// ============================================================

model PlayerSession {
  id            String    @id @default(uuid()) @map("session_id")
  rootId        String    @map("root_id")
  sourceId      String    @map("source_id")
  zone          String?
  status        String    @default("active")
  checkedInAt   DateTime  @default(now()) @map("checked_in_at")
  lastHeartbeat DateTime  @default(now()) @map("last_heartbeat")
  checkedOutAt  DateTime? @map("checked_out_at")
  durationSec   Int?      @map("duration_sec")
  summary       Json?

  root   RootIdentity @relation(fields: [rootId], references: [id], onDelete: Cascade)

  @@index([rootId])
  @@index([status])
  @@index([sourceId, status])
  @@index([checkedInAt])
  @@map("player_sessions")
}

// ============================================================
// QUESTS
// ============================================================

model QuestTemplate {
  id          String    @id @default(uuid()) @map("quest_id")
  slug        String?   @unique
  name        String
  description String?
  questType   String    @map("quest_type")
  // cadence: 'venue' (legacy Sprint 7.3 board) | 'daily' | 'weekly' | 'story'
  cadence     String    @default("venue")
  // story chains: chainKey groups steps, chainStep orders them;
  // step n+1 materializes when step n is claimed
  chainKey    String?   @map("chain_key")
  chainStep   Int?      @map("chain_step")
  // tag feeds external counters (e.g. 'forge_work' → Forge restoration points)
  tag         String?
  objectives  Json
  rewards     Json
  minLevel    Int       @default(1) @map("min_level")
  maxLevel    Int?      @map("max_level")
  sourceId    String?   @map("source_id")
  sortOrder   Int       @default(0) @map("sort_order")
  status      String    @default("active")
  createdAt   DateTime  @default(now()) @map("created_at")

  playerQuests PlayerQuest[]

  @@index([status])
  @@index([questType])
  @@index([cadence, status])
  @@index([chainKey])
  @@map("quest_templates")
}

model PlayerQuest {
  id          String    @id @default(uuid()) @map("player_quest_id")
  rootId      String    @map("root_id")
  questId     String    @map("quest_id")
  // 'once' for story/venue; 'YYYY-MM-DD' for daily; 'YYYY-Wnn' for weekly
  periodKey   String    @default("once") @map("period_key")
  // active → completed → claimed (rewards granted at claim for cadence quests)
  status      String    @default("active")
  progress    Json      @default("[]")
  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")
  claimedAt   DateTime? @map("claimed_at")

  root     RootIdentity  @relation(fields: [rootId], references: [id], onDelete: Cascade)
  quest    QuestTemplate @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([rootId, questId, periodKey])
  @@index([rootId, status])
  @@index([rootId, periodKey])
  @@index([questId])
  @@map("player_quests")
}

// ============================================================
// CONFIG
// ============================================================

model Config {
  key         String    @id @map("config_key")
  value       String    @map("config_value")
  description String?
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("config")
}

// ============================================================
// TRAINING SYSTEM
// ============================================================
// Pool of rite templates drawn from when generating daily rites.
// Seeded once — operator can add more over time.
model RiteTemplate {
  id          String  @id @default(uuid()) @map("rite_template_id")
  pillar      String                        // forge | lore | veil
  title       String                        // "Complete 20 min of cardio"
  description String?                       // Flavour text
  loreText    String? @map("lore_text")     // In-world framing
  xpBase      Int     @default(50) @map("xp_base")
  difficulty  String  @default("standard")  // easy | standard | hard
  status      String  @default("active")    // active | retired

  dailyRites  DailyRite[]

  @@index([pillar, status])
  @@map("rite_templates")
}

// A hero's generated daily rites for a specific date.
// Created on first GET /api/training/daily/:rootId for that day.
model DailyRite {
  id           String    @id @default(uuid()) @map("daily_rite_id")
  rootId       String    @map("root_id")
  templateId   String    @map("template_id")
  dateKey      String    @map("date_key")      // "2026-03-08" UTC date string
  pillar       String                           // forge | lore | veil (denorm for query speed)
  status       String    @default("pending")   // pending | completed | skipped
  completedAt  DateTime? @map("completed_at")
  xpGranted    Int?      @map("xp_granted")    // Set on completion

  root         RootIdentity  @relation(fields: [rootId], references: [id], onDelete: Cascade)
  template     RiteTemplate  @relation(fields: [templateId], references: [id])

  @@unique([rootId, dateKey, pillar])           // One rite per pillar per day
  @@index([rootId, dateKey])
  @@map("daily_rites")
}

// Individual training log entries (the Chronicle).
model TrainingEntry {
  id           String    @id @default(uuid()) @map("entry_id")
  rootId       String    @map("root_id")
  pillar       String                           // forge | lore | veil
  activityType String    @map("activity_type")  // workout | cardio | sport | reading | writing | meditation | prayer | service | other
  durationMin  Int?      @map("duration_min")
  notes        String?
  xpGranted    Int       @default(0) @map("xp_granted")
  dailyRiteId  String?   @map("daily_rite_id")  // Linked rite if this was a rite completion
  createdAt    DateTime  @default(now()) @map("created_at")

  root         RootIdentity @relation(fields: [rootId], references: [id], onDelete: Cascade)

  @@index([rootId, createdAt])
  @@index([rootId, pillar])
  @@map("training_entries")
}

// Per-hero pillar XP tracking (separate from fate_xp).
model PillarProgress {
  id           String    @id @default(uuid()) @map("pillar_progress_id")
  rootId       String    @map("root_id")
  pillar       String                           // forge | lore | veil
  xp           Int       @default(0)
  level        Int       @default(1)
  streak       Int       @default(0)            // Current day streak
  longestStreak Int      @default(0) @map("longest_streak")
  lastActivityAt DateTime? @map("last_activity_at")

  root         RootIdentity @relation(fields: [rootId], references: [id], onDelete: Cascade)

  @@unique([rootId, pillar])
  @@index([rootId])
  @@map("pillar_progress")
}

// Weekly oath declarations.
model Oath {
  id           String    @id @default(uuid()) @map("oath_id")
  rootId       String    @map("root_id")
  pillar       String                           // forge | lore | veil
  declaration  String                           // Free text — what they commit to
  weekOf       String    @map("week_of")        // ISO week start "2026-03-04"
  status       String    @default("pending")   // pending | kept | broken
  resolvedAt   DateTime? @map("resolved_at")
  xpGranted    Int?      @map("xp_granted")

  root         RootIdentity @relation(fields: [rootId], references: [id], onDelete: Cascade)

  @@unique([rootId, weekOf])                    // One oath per hero per week
  @@index([rootId, status])
  @@map("oaths")
}

// ============================================================
// SANCTUM (iOS) — Sprint 28
// In-app daily ritual state. One row per hero. Distinct from the
// legacy web rite/oath models above (different mechanics, different
// cadence, different resource economy). Rolls over by UTC date.
// ============================================================
model SanctumState {
  rootId             String    @id @map("root_id")
  veilEssence        Int       @default(0) @map("veil_essence")
  lastHearthClaim    String?   @map("last_hearth_claim")    // 'YYYY-MM-DD' UTC
  oathTodayDate      String?   @map("oath_today_date")       // 'YYYY-MM-DD' UTC
  oathTodayOption    String?   @map("oath_today_option")     // 'forge' | 'lore' | 'veil'
  totalHearthClaims  Int       @default(0) @map("total_hearth_claims")
  totalOathsSworn    Int       @default(0) @map("total_oaths_sworn")
  // Sprint 30 — daily Veil Trial (snackable 60s minigame).
  // last_trial_complete gates one-per-day, mirroring Hearth's pattern.
  lastTrialComplete  String?   @map("last_trial_complete")   // 'YYYY-MM-DD' UTC
  totalTrials        Int       @default(0) @map("total_trials")
  bestTrialScore     Int       @default(0) @map("best_trial_score")
  // Sprint 30 Slice 5.2 — daily Augury Draw (3-card weighted reveal).
  lastAuguryDate     String?   @map("last_augury_date")      // 'YYYY-MM-DD' UTC
  totalAuguries      Int       @default(0) @map("total_auguries")
  // 2026-07-06 — committed restoration levels. Progress POINTS are
  // computed from lifetime counters (never stored); committing a
  // level is an explicit player action (the UPGRADE button),
  // validated server-side by SanctumService.upgrade() against the
  // points thresholds + wing-level prerequisites. Hearth/Altar
  // columns are reserved — their progression tracks ship with
  // their interiors.
  sanctumLevel       Int       @default(1) @map("sanctum_level")
  libraryLevel       Int       @default(1) @map("library_level")
  forgeLevel         Int       @default(1) @map("forge_level")
  hearthLevel        Int       @default(1) @map("hearth_level")
  altarLevel         Int       @default(1) @map("altar_level")
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at")

  root         RootIdentity @relation(fields: [rootId], references: [id], onDelete: Cascade)

  @@map("sanctum_state")
}

// ============================================================
// FATE FOX — Sprint 31 / Tier 2 companion-bond
//
// Per docs/canon/progression.md § 6, every Awakened may bond one
// Fate Fox; the bond is permanent on both sides. Fox is a modifier
// layer — utility nudges (XP yield, cache rarity, etc.), NEVER
// combat power. v1 implements only the bond + a flat +5% Fate XP
// nudge; future slices add more modifier types + cosmetic skins.
//
// rootId is @unique because each hero bonds exactly one Fox for life.
// ============================================================
model FateFox {
  id        String   @id @default(uuid()) @map("fox_id")
  rootId    String   @unique @map("root_id")
  name      String
  bondedAt  DateTime @default(now()) @map("bonded_at")

  // ── The Calling (2026-07-09) — the fox is REVEALED, not built.
  // Virtue scoring assigns the archetype; the archetype fixes the
  // immutable physical traits; the player customizes expression
  // only (canon: the game chooses the soul, the player chooses
  // the expression, the journey shapes the legend).
  archetype         String?   // guardian|seeker|sage|ember|hearth|warden
  virtueProfile     Json?     @map("virtue_profile")
  immutableTraits   Json?     @map("immutable_traits")
  customization     Json?     // furPrimary/furSecondary/eyeColor/collar/pendant/auraColor
  bondLevel         Int       @default(1) @map("bond_level")
  personalitySeed   String?   @map("personality_seed")
  unlockedCosmetics Json      @default("[]") @map("unlocked_cosmetics")
  revealedAt        DateTime? @map("revealed_at")

  root      RootIdentity @relation(fields: [rootId], references: [id], onDelete: Cascade)

  @@map("fate_foxes")
}

// ============================================================
// MEMORIA — Sprint 32 Tier 2 identity-collection axis
//
// Each Memoria is a kept moment: a breath, a coal, a whisker.
// Granted idempotently when the player crosses a defined
// identity threshold (Awakening, Fox bond, first rank-up, etc).
//
// Identity weight, not power. Memoria do not affect combat,
// XP, or rewards — they exist purely as the persistent record
// of who the hero has become.
//
// The grant trigger lives in code (MemoriaService) keyed by
// triggerKey; the DB stores the def's display metadata only.
// New Memoria ship via INSERT + a new resolver in the service.
// ============================================================
model Memoria {
  id           String   @id @map("memoria_id")     // slug, e.g. 'first_breath'
  name         String                                // 'THE FIRST BREATH'
  lore         String                                // one-or-two-line narrative, mythic register
  glyph        String                                // single char rendered on the collection grid
  accent       String                                // hex color for ring + Chronicle entry
  triggerKey   String   @map("trigger_key")         // matches a resolver in MemoriaService
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")

  grants       PlayerMemoria[]

  @@map("memoria_defs")
}

model PlayerMemoria {
  id            String   @id @default(uuid()) @map("player_memoria_id")
  rootId        String   @map("root_id")
  memoriaId     String   @map("memoria_id")
  grantedAt     DateTime @default(now()) @map("granted_at")
  // Pointer back to the IdentityEvent that triggered the grant, so
  // future surfaces (XR, lore zoom-ins) can re-link "you got this
  // BECAUSE…" without re-deriving from the ledger every time.
  sourceEventId String?  @map("source_event_id")

  root          RootIdentity @relation(fields: [rootId], references: [id], onDelete: Cascade)
  memoria       Memoria      @relation(fields: [memoriaId], references: [id], onDelete: Cascade)

  @@unique([rootId, memoriaId])
  @@index([rootId])
  @@map("player_memoria")
}

// ============================================================
// LORE ARCHIVE — 2026-07-06 collection quest
//
// A Pokémon-Go-style collection: heroes recover lore entries by
// sealing tears out in the world (rarity-weighted drop of a not-
// yet-found entry). The catalog lives in the DB so new entries
// ship without a redeploy (same platform move as AuguryCard).
// Library restoration on the client is weighted by finds.
// Parallel to — not replacing — the future Hero Echo system.
// ============================================================
model LoreEntry {
  id           String   @id @map("lore_id")       // slug 'veil_first_tear'
  title        String                               // 'THE FIRST TEAR'
  category     String                               // 'veil'|'regions'|'rites'|'bestiary'|'orders'
  rarity       String   @default("common")          // common|uncommon|rare|epic|legendary
  body         String                               // entry text, mythic register
  glyph        String   @default("◈")               // grid glyph
  displayOrder Int      @default(0) @map("display_order")
  active       Boolean  @default(true)              // disable without deleting
  createdAt    DateTime @default(now()) @map("created_at")

  finds        HeroLore[]

  @@map("lore_entries")
}

model HeroLore {
  id      String   @id @default(uuid()) @map("hero_lore_id")
  rootId  String   @map("root_id")
  loreId  String   @map("lore_id")
  foundAt DateTime @default(now()) @map("found_at")
  source  String?                                    // 'tear_seal' | future hooks

  root    RootIdentity @relation(fields: [rootId], references: [id], onDelete: Cascade)
  entry   LoreEntry    @relation(fields: [loreId], references: [id], onDelete: Cascade)

  @@unique([rootId, loreId])
  @@index([rootId])
  @@map("hero_lore")
}

// ============================================================
// AUGURY CARDS — Sprint 31 modular content-injection
//
// The daily Augury Draw deck. Lives in the DB so new cards (and
// seasonal cards, A/B test weights, rebalancing) ship without a
// redeploy. Per memory:strategic_north_star.md, this is the
// platform-shaped move that lets the same architecture later host
// quest-of-the-week / event-of-the-month content.
// ============================================================
model AuguryCard {
  id          String   @id @map("card_id")    // 'wisp-fragment' — stable slug
  name        String                            // 'WISP FRAGMENT' (display)
  flavor      String                            // 'A pale wisp drifts past your fingers.'
  rarity      String                            // 'common' | 'uncommon' | 'rare' | 'epic' | 'legendary'
  weight      Int                               // weighted-random pick weight
  rewards     Json                              // { essence?, fate_xp?, cache? }
  active      Boolean  @default(true)           // disable without deleting
  // Seasonal flag — cards with season != null are only eligible
  // for draws during their named season (e.g. 'hallow'). NULL =
  // permanent deck. Adds zero overhead to base draws (NULL is the
  // default match).
  season      String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([active])
  @@index([season])
  @@map("augury_cards")
}

// ============================================================
// IAP (iOS) — Sprint 28
// One row per StoreKit 2 transaction. Idempotent on the Apple
// transactionId so double-network can't double-credit. Refund
// handling (Server Notifications V2) is post-v1.0; refundedAt
// stays null until that landing.
// ============================================================
model IapPurchase {
  id                  String    @id @default(uuid()) @map("iap_id")
  rootId              String    @map("root_id")
  sku                 String                                  // 'essence_small' | 'essence_pack' | 'essence_hoard'
  essenceGranted      Int       @map("essence_granted")
  platform            String    @default("ios")               // 'ios' | 'android'
  // Apple (StoreKit 2) — null for Android rows.
  appleTransactionId  String?   @unique @map("apple_transaction_id")  // Apple's canonical transactionId
  appleEnvironment    String?   @map("apple_environment")     // 'Sandbox' | 'Production'
  appleBundleId       String?   @map("apple_bundle_id")
  // Google Play — null for iOS rows. orderId is the dedup key.
  googleOrderId       String?   @unique @map("google_order_id")
  googlePurchaseToken String?   @map("google_purchase_token")
  status              String    @default("granted")            // granted | refunded | revoked
  refundedAt          DateTime? @map("refunded_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  root RootIdentity @relation(fields: [rootId], references: [id], onDelete: Cascade)

  @@index([rootId, createdAt])
  @@map("iap_purchases")
}

// ============================================================
// ECONOMY SYSTEM — Nexus currency + crafting components
// ============================================================
model PlayerNexus {
  id        String   @id @default(uuid()) @map("nexus_id")
  rootId    String   @unique @map("root_id")
  balance   Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  root RootIdentity @relation(fields: [rootId], references: [id], onDelete: Cascade)

  @@index([rootId])
  @@map("player_nexus")
}

model PlayerComponents {
  id            String   @id @default(uuid()) @map("component_id")
  rootId        String   @map("root_id")
  componentType String   @map("component_type")
  quantity      Int      @default(0)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  root RootIdentity @relation(fields: [rootId], references: [id], onDelete: Cascade)

  @@unique([rootId, componentType])
  @@index([rootId])
  @@map("player_components")
}

// ============================================================
// VEIL TEARS — Sprint 13
// ──────────────────────────────────────────────

// Per-hero Veil Shard currency balance.
// One row per hero, upserted on each victory.
model VeilShard {
  id        String       @id @default(uuid()) @map("shard_id")
  rootId    String       @unique @map("root_id")
  balance   Int          @default(0)
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at")

  root RootIdentity @relation(fields: [rootId], references: [id], onDelete: Cascade)

  @@map("veil_shards")
}

// Individual battle record — one row per encounter outcome.
model TearEncounter {
  id        String    @id @default(uuid()) @map("encounter_id")
  rootId    String    @map("root_id")
  tearType  String    @map("tear_type")   // minor | wander | dormant | double
  tearName  String    @map("tear_name")
  outcome   String                        // won | fled
  shards    Int       @default(0)
  lat       Float?                        // GPS coords for future map features
  lon       Float?
  createdAt DateTime  @default(now()) @map("created_at")

  root RootIdentity @relation(fields: [rootId], references: [id], onDelete: Cascade)

  @@index([rootId, createdAt])
  @@index([rootId, outcome])
  @@map("tear_encounters")
}

// ============================================================
// PHASE 2 — Convergence Events
// ============================================================

// Active time-limited world events that boost rewards or alter spawns.
// Checked on every encounter — applied automatically by veil.service.
model ConvergenceEvent {
  id                  String   @id @default(uuid()) @map("event_id")
  name                String
  description         String?
  flavorText          String?  @map("flavor_text")
  affectedTiers       String[] @map("affected_tiers")
  shardMultiplier     Float    @default(1.0) @map("shard_multiplier")
  cacheBonus          Boolean  @default(false) @map("cache_bonus")
  startsAt            DateTime @map("starts_at")
  endsAt              DateTime @map("ends_at")
  status              String   @default("active")
  createdAt           DateTime @default(now()) @map("created_at")
  // Sprint 24 — global contribution tracking
  contributionCount   Int      @default(0) @map("contribution_count")
  targetCount         Int      @default(10000) @map("target_count")

  contributions       ConvergenceContribution[]

  @@index([status, endsAt])
  @@map("convergence_events")
}

model ConvergenceContribution {
  id          String   @id @default(uuid())
  eventId     String   @map("event_id")
  rootId      String   @map("root_id")
  warbandId   String?  @map("warband_id")
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt @map("updated_at")

  event       ConvergenceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  hero        RootIdentity     @relation(fields: [rootId], references: [id], onDelete: Cascade)

  @@unique([eventId, rootId])
  @@index([eventId])
  @@index([rootId])
  @@map("convergence_contributions")
}

model BaseItem {
  id            String   @id
  name          String
  slot          String
  levelMin      Int      @map("level_min")
  levelMax      Int      @map("level_max")
  levelBand     String   @map("level_band")
  regionTheme   String   @map("region_theme")
  itemFamily    String   @map("item_family")
  rarityAllowed String[] @map("rarity_allowed")
  pre40Only     Boolean  @default(true) @map("pre40_only")
  loreTags      String[] @default([]) @map("lore_tags")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([slot, levelBand])
  @@index([regionTheme])
  @@map("base_items")
}

model PityCounter {
  id        String   @id @default(uuid())
  rootId    String   @map("root_id")
  pityType  String   @map("pity_type")
  counter   Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  root      RootIdentity @relation(fields: [rootId], references: [id], onDelete: Cascade)

  @@unique([rootId, pityType])
  @@index([rootId])
  @@map("pity_counters")
}

model Warband {
  id           String   @id @default(uuid())
  name         String
  emblem       String   @default("⚔")
  alignment    String   @default("NONE")      // PRIMARY alignment — open to others
  reputation   Int      @default(0)
  foundedAt    DateTime @default(now()) @map("founded_at")
  founderRootId String  @map("founder_root_id")

  members      WarbandMembership[]
  invites      WarbandInvite[]
  founder      RootIdentity @relation(fields: [founderRootId], references: [id], onDelete: Cascade)

  @@index([alignment])
  @@index([reputation])
  @@map("warbands")
}

model WarbandMembership {
  id              String   @id @default(uuid())
  warbandId       String   @map("warband_id")
  rootId          String   @map("root_id")
  rank            String   @default("MEMBER")  // FOUNDER | OFFICER | MEMBER
  alignmentBonus  Boolean  @default(false) @map("alignment_bonus")
  joinedAt        DateTime @default(now()) @map("joined_at")

  warband         Warband      @relation(fields: [warbandId], references: [id], onDelete: Cascade)
  hero            RootIdentity @relation(fields: [rootId], references: [id], onDelete: Cascade)

  @@unique([warbandId, rootId])
  @@index([rootId])
  @@index([warbandId])
  @@map("warband_memberships")
}

model WarbandInvite {
  id              String   @id @default(uuid())
  warbandId       String   @map("warband_id")
  invitedByRootId String   @map("invited_by_root_id")
  inviteCode      String   @unique @map("invite_code")
  status          String   @default("pending")  // pending | accepted | expired
  expiresAt       DateTime @map("expires_at")
  createdAt       DateTime @default(now()) @map("created_at")

  warband         Warband      @relation(fields: [warbandId], references: [id], onDelete: Cascade)
  invitedBy       RootIdentity @relation("InviteSender", fields: [invitedByRootId], references: [id], onDelete: Cascade)

  @@index([inviteCode])
  @@index([warbandId])
  @@map("warband_invites")
}

// ============================================================
// LANDMARKS + LORE DISCOVERY — Sprint 25
// Tables created via POST /api/landmarks/bootstrap
// (bootstrap pattern — not prisma migrate execute)
// ============================================================

model Landmark {
  id               String   @id @map("landmark_id")
  name             String
  region           String
  tier             Int      @default(1)
  type             String   @default("public")   // hv_venue | public | operator
  lat              Float
  lon              Float
  radiusMeters     Int      @default(100) @map("radius_meters")
  isAutoRegistered Boolean  @default(false) @map("is_auto_registered")
  createdAt        DateTime @default(now()) @map("created_at")

  discoveries      LandmarkDiscovery[]

  @@index([region])
  @@map("landmarks")
}

model LandmarkDiscovery {
  id            String   @id @default(uuid()) @map("discovery_id")
  heroId        String   @map("hero_id")
  landmarkId    String   @map("landmark_id")
  fragmentIndex Int      @map("fragment_index")   // 1 | 2 | 3
  discoveredAt  DateTime @default(now()) @map("discovered_at")

  hero          RootIdentity @relation(fields: [heroId], references: [id], onDelete: Cascade)
  landmark      Landmark     @relation(fields: [landmarkId], references: [id], onDelete: Cascade)

  @@unique([heroId, landmarkId, fragmentIndex])
  @@index([heroId])
  @@index([landmarkId])
  @@map("landmark_discoveries")
}

// ============================================================
// WORLD TEARS — Sprint 29 / Arc B
// Geo-aware rifts seeded across real-world cities. The iOS Map
// screen swaps procedural spawnTears for /api/veil/tears/nearby
// queries against this table. Tier maps 1:1 to client tear type
// (T1 minor, T2 wander, T3 dormant, T4 double).
//
// Lifecycle (slice 3, not yet implemented):
//   spawned_at → active 24h → expires OR sealed by first hero.
//
// Indexes are a coarse bbox optimization; v2 wants postgis +
// gist for proper great-circle distance queries.
// ============================================================
model WorldTear {
  id              String    @id @default(uuid()) @map("tear_id")
  lat             Float
  lon             Float
  tier            String                                  // 'T1' | 'T2' | 'T3' | 'T4'
  status          String    @default("active")            // 'active' | 'sealed' | 'expired'
  spawnedAt       DateTime  @default(now()) @map("spawned_at")
  expiresAt       DateTime? @map("expires_at")
  sealedAt        DateTime? @map("sealed_at")
  sealedByRootId  String?   @map("sealed_by_root_id")
  regionLabel     String?   @map("region_label")          // e.g. 'folsom-ca', 'london-uk' — for analytics, not auth

  sealedBy        RootIdentity? @relation(fields: [sealedByRootId], references: [id], onDelete: SetNull)

  @@index([status, lat, lon])
  @@index([sealedByRootId])
  @@index([regionLabel, status])
  @@map("world_tears")
}

// ============================================================
// PROCEDURAL VEIL GENERATION (Phase 2 Arc B — slice 4)
// ============================================================

// Precomputed population-weighted grid. One row per ~0.05° land
// cell that has (or is near) population. `weight` drives how many
// tears that cell procedurally spawns; absent cells (open ocean /
// far wilderness) generate ~none. Seeded offline from GeoNames
// cities1000 by scripts/seed-pop-grid.ts — NOT a migration (too
// large for `migrate deploy`). Read-only at request time: a single
// PK `IN (...)` lookup per /tears/nearby call.
model PopCell {
  cellKey     String  @id @map("cell_key")        // "{latIdx}:{lonIdx}" at CELL_DEG resolution
  weight      Float                               // population-derived density multiplier
  regionLabel String? @map("region_label")        // nearest-city slug, e.g. 'folsom-ca' — analytics only
  centerLat   Float   @map("center_lat")          // cell center, for debugging / map overlays
  centerLon   Float   @map("center_lon")

  @@map("pop_cell")
}

// Seal overlay for procedurally-generated tears. Generated tears
// have no active row to mutate, so a seal is recorded here and the
// generator EXCLUDES any tear_id whose cooldown hasn't elapsed.
// After cooldown the slot regenerates (density self-heals). Legacy
// stored-row seals still live on world_tears (see veil.service
// sealWorldTear branch). `sealedByRootId` is a loose string (no FK)
// to preserve the existing soft-fail intent — a missing root must
// never block a seal.
model TearSeal {
  tearId         String   @id @map("tear_id")     // "{cellKey}#{slot}"
  cellKey        String   @map("cell_key")
  sealedAt       DateTime @default(now()) @map("sealed_at")
  sealedByRootId String?  @map("sealed_by_root_id")
  cooldownUntil  DateTime @map("cooldown_until")

  @@index([cooldownUntil])
  @@index([cellKey])
  @@map("tear_seal")
}

// ============================================================
// RESTORATION ECONOMY (2026-07-10) — upgrades cost essence +
// materials and take real-world time. One in-flight build per
// (root, track), enforced in code; completion is CLAIMED (the
// ceremony beat), never auto-applied. Loose rootId strings like
// tear_seal — a missing root must never block reads.
// ============================================================
model SanctumBuild {
  id          String    @id @default(uuid())
  rootId      String    @map("root_id")
  track       String
  toLevel     Int       @map("to_level")
  essence     Int       // cost snapshot at start
  materials   Json      @default("{}")
  startedAt   DateTime  @default(now()) @map("started_at")
  readyAt     DateTime  @map("ready_at")
  completedAt DateTime? @map("completed_at")

  @@index([rootId])
  @@map("sanctum_builds")
}

model MaterialStock {
  rootId   String @map("root_id")
  material String // veilglass | leywood | ore
  count    Int    @default(0)

  @@id([rootId, material])
  @@map("material_stocks")
}

// ============================================================
// VEIL FAUNA (2026-07-10) — escaped creatures near tear sites.
// Spawns are deterministic (hashed from tear id + time slot), so
// only the hero's side persists: banish idempotence + bestiary
// tallies. Loose rootId strings like tear_seal.
// ============================================================
model FaunaBanish {
  rootId     String   @map("root_id")
  faunaId    String   @map("fauna_id")
  species    String
  banishedAt DateTime @default(now()) @map("banished_at")

  @@id([rootId, faunaId])
  @@map("fauna_banish")
}

model HeroFauna {
  rootId  String   @map("root_id")
  species String
  count   Int      @default(0)
  firstAt DateTime @default(now()) @map("first_at")
  lastAt  DateTime @default(now()) @map("last_at")

  @@id([rootId, species])
  @@map("hero_fauna")
}

// Feature flags — runtime feature control per release channel
// (2026-07-09, alpha pipeline). Resolution: a channel-specific row
// ('alpha', 'preview', …) overrides the default row (channel '').
// Unknown keys fall back to client-side defaults (fail-open).
model FeatureFlag {
  id        String   @id @default(uuid())
  key       String
  channel   String   @default("")   // '' = all channels
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([key, channel])
  @@map("feature_flags")
}

// ════════════════════════════════════════════════════════════════════════
// HEP Phase 2 Slice 4 — spatial data model
//
// The contract an external XR team builds against. Tier C is partnered
// out, which is exactly why this lives here and lands first: a partner
// with no contract invents one, and then we integrate against their
// assumptions instead of ours.
//
// ── The one commitment everything else depends on ─────────────────────
// Every pose persisted below is in ROOM-LOCAL coordinates: metres, Y up,
// origin at the room's calibrated origin anchor. Never device space,
// never provider space. Two headsets that resolve the same room disagree
// about where the world is and agree about where the room is, so
// room-local is the only frame in which their state can be compared —
// which is what makes shared-spatial multiplayer possible later without
// a migration (Workstream 11).
//
// ── Additive only ─────────────────────────────────────────────────────
// Nothing here changes existing Codex or venue behavior. A venue with no
// rooms is exactly as it was.
// ════════════════════════════════════════════════════════════════════════

/// A physical room at a venue. Long-lived: survives every recalibration.
///
/// Distinct from RoomConfig, which is one *calibration* of this room. The
/// room is the place; the config is our current belief about where its
/// origin sits. Conflating them would mean a recalibration silently
/// rewriting the history of every run measured against the old one.
model VenueRoom {
  id       String @id @default(uuid()) @map("room_id")
  sourceId String @map("source_id")
  /// Venue-scoped operator-facing key, e.g. 'trial-chamber-a'.
  slug     String
  name     String

  /// Free-form physical description: dimensions, materials, lighting,
  /// furniture. Workstream 8.2 wants one canonical reference room
  /// recorded in this much detail; deliberately Json because a partner
  /// will want fields we have not thought of.
  profile  Json   @default("{}")

  /// Which published config is live. Null until first publish.
  /// Rollback is repointing this, never mutating a config.
  activeConfigId String? @unique @map("active_config_id")

  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  source       Source      @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  configs      RoomConfig[] @relation("RoomConfigs")
  activeConfig RoomConfig?  @relation("ActiveConfig", fields: [activeConfigId], references: [id])

  @@unique([sourceId, slug])
  @@index([sourceId, status])
  @@map("venue_rooms")
}

/// One immutable, published calibration of a room.
///
/// IMMUTABLE once status='published'. A recalibration is a new row with
/// version+1, never an edit. This is not fastidiousness: every run's
/// spatial telemetry is measured against the config that was live at the
/// time, and an editable config would make historical drift and error
/// figures unattributable — the measurements would silently start
/// referring to a room origin that no longer existed when they were taken.
model RoomConfig {
  id      String @id @default(uuid()) @map("room_config_id")
  roomId  String @map("room_id")
  version Int

  /// draft | published | archived.
  /// Only a draft may be mutated; publishing freezes it.
  status  String @default("draft")

  /// Which experience + version this calibration was laid out for.
  /// A room is calibrated FOR content — placements are meaningless
  /// without knowing what they were placing.
  experienceId      String? @map("experience_id")
  experienceVersion Int?    @map("experience_version")

  /// How the origin was established — 'fiducial' (Mode A) or 'native'
  /// (Mode B). Recorded because the recovery action an operator is told
  /// to perform differs, and because comparing drift between the two is
  /// the whole point of running both in the pilot.
  originMode String @default("fiducial") @map("origin_mode")

  /// The intended forward direction, in room-local space (Step 4).
  /// Separate from the origin anchor's own rotation: the operator may
  /// establish position from a floor plate and facing from a wall.
  orientationReference Json? @map("orientation_reference")

  /// Validation verdict at publish time (Step 7): measured errors against
  /// tolerances. Frozen with the config so a later tolerance change
  /// cannot retroactively make a published room look like it passed.
  validation Json @default("{}")

  /// Device profiles this calibration is certified for. A config
  /// validated on a headset is not automatically valid on mobile AR.
  supportedDeviceProfiles String[] @default([]) @map("supported_device_profiles")

  publishedAt DateTime? @map("published_at")
  /// VenueStaff.id of the publishing operator. Null = platform.
  publishedBy String?   @map("published_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  room        VenueRoom          @relation("RoomConfigs", fields: [roomId], references: [id], onDelete: Cascade)
  activeFor   VenueRoom?         @relation("ActiveConfig")
  anchors     AnchorRecord[]
  placements  ContentPlacement[]
  zones       SpatialZone[]

  @@unique([roomId, version])
  @@index([roomId, status])
  @@map("room_configs")
}

/// A spatial anchor as the PROVIDER knows it.
///
/// Provider-agnostic by construction (Workstream 2): `provider` +
/// `providerAnchorId` is the whole vendor coupling, and it is two
/// columns. An ARCore Cloud Anchor id, a Meta spatial anchor uuid and a
/// printed marker id are all just strings here, so swapping providers —
/// or running two at once during the Mode A/Mode B comparison — costs no
/// schema change.
model AnchorRecord {
  id           String @id @default(uuid()) @map("anchor_id")
  roomConfigId String @map("room_config_id")

  /// Manifest anchor name (e.g. 'HERO_ECHO_MAIN') or 'ORIGIN'.
  name String
  /// origin | content | verification | marker
  role String @default("content")

  /// arcore | meta | local_marker | editor_sim | androidxr
  provider        String
  /// Opaque to us. Cloud-anchor ids are billable and TTL'd, which is why
  /// deletion is tracked rather than the row being hard-deleted.
  providerAnchorId String? @map("provider_anchor_id")
  /// Fiducial marker identifier, when originMode='fiducial'.
  markerId         String? @map("marker_id")

  /// Pose in ROOM-LOCAL space. [x,y,z] metres and [x,y,z] degrees euler.
  /// For the origin anchor this is the identity pose by definition —
  /// stored anyway so the record is self-describing to a partner reading
  /// one row without knowing our conventions.
  localPosition Float[] @map("local_position")
  localRotation Float[] @map("local_rotation")

  /// Provider-reported confidence at capture, 0..1 when available.
  trackingConfidence Float?  @map("tracking_confidence")
  /// Device that captured it — drift is device-dependent.
  capturedByDevice   String? @map("captured_by_device")
  capturedAt         DateTime @default(now()) @map("captured_at")

  /// Set when released at the provider. Soft so an orphaned billable
  /// cloud anchor is auditable rather than merely gone from our side.
  releasedAt DateTime? @map("released_at")

  config RoomConfig @relation(fields: [roomConfigId], references: [id], onDelete: Cascade)

  @@unique([roomConfigId, name])
  @@index([roomConfigId, role])
  @@map("anchor_records")
}

/// Where a manifest's required content sits in this specific room.
///
/// The join between "what the experience needs" (Experience.manifest) and
/// "how it fits here" (this row). That separation is the reason an
/// experience can be re-deployed to a second venue without re-authoring.
model ContentPlacement {
  id           String @id @default(uuid()) @map("placement_id")
  roomConfigId String @map("room_config_id")

  /// Must match a requiredAnchors[].name in the experience manifest.
  /// Validated at publish — a placement naming nothing is a calibration
  /// that will fail at runtime, and it should fail at publish instead.
  anchorName String @map("anchor_name")

  /// Room-local pose. Overrides the manifest's suggested pose, which is
  /// authored for an idealised room.
  localPosition Float[] @map("local_position")
  localRotation Float[] @map("local_rotation")
  localScale    Float[] @default([1, 1, 1]) @map("local_scale")

  /// Operator note — "behind the pillar, left of the door".
  notes String?

  config RoomConfig @relation(fields: [roomConfigId], references: [id], onDelete: Cascade)

  @@unique([roomConfigId, anchorName])
  @@map("content_placements")
}

/// A volume in the room: where a player starts, where they may interact,
/// and where they must not be.
model SpatialZone {
  id           String @id @default(uuid()) @map("zone_id")
  roomConfigId String @map("room_config_id")

  name String
  /// player_start | interaction | safety | clearance
  kind String
  /// circle | box | polygon
  shape String

  /// Shape parameters, keyed by shape: {radius} | {size:[x,y,z]} |
  /// {points:[[x,z],…]}. Json because three shapes with disjoint
  /// parameters in flat columns would be mostly nulls.
  geometry Json

  /// Room-local centre.
  localPosition Float[] @map("local_position")
  localRotation Float[] @default([0, 0, 0]) @map("local_rotation")

  config RoomConfig @relation(fields: [roomConfigId], references: [id], onDelete: Cascade)

  @@unique([roomConfigId, name])
  @@index([roomConfigId, kind])
  @@map("spatial_zones")
}

/// A class of device, and what content may assume about it.
///
/// Heroes-authored and global, NOT per-venue: a partner selecting their
/// own performance budget is how you get an experience that ships at
/// 20fps and a support ticket. Tiers A/B/C per Workstream 6.
model DeviceCapabilityProfile {
  id   String @id @default(uuid()) @map("profile_id")
  /// e.g. 'tier-a-mobile-ar', 'tier-b-standalone-headset'
  slug String @unique
  name String
  /// A | B | C
  tier String

  supportsSharedAnchors     Boolean @default(false) @map("supports_shared_anchors")
  supportsPersistentAnchors Boolean @default(false) @map("supports_persistent_anchors")
  supportsSceneMesh         Boolean @default(false) @map("supports_scene_mesh")
  supportsHandTracking      Boolean @default(false) @map("supports_hand_tracking")
  supportsOcclusion         Boolean @default(false) @map("supports_occlusion")

  /// Asset + runtime budget: triangles, texture MB, draw calls, particles,
  /// target fps. Data, not code — retuning a budget must not be a deploy,
  /// the same principle Experience.rewards already follows.
  budgets Json @default("{}")

  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("device_capability_profiles")
}

// ════════════════════════════════════════════════════════════════════════
// HEP Phase 2 Slice 6 — spatial telemetry
//
// "Looks aligned" is not an acceptable test result (Workstream 9). These
// rows are how a threshold becomes enforceable by something other than
// someone reading a spreadsheet.
//
// ── Why one generic table and not thirty columns ──────────────────────
// The spec lists ~25 metrics across anchor, runtime and player groups,
// explicitly as INITIAL targets to be tuned after testing. A column per
// metric would mean a migration every time the partner learns something,
// and they will learn something every week of the pilot. Name + value +
// unit costs one index and survives a metric we have not thought of.
// ════════════════════════════════════════════════════════════════════════

/// One measurement, reported by a client, about one session.
///
/// Attributed to the RoomConfig that was live when it was taken — which
/// is the entire reason RoomConfig is immutable. A drift figure means
/// nothing without knowing which calibration it drifted from.
model SpatialMetric {
  id       String @id @default(uuid()) @map("metric_id")
  sourceId String @map("source_id")
  /// Null for measurements taken outside a run (calibration, warm-up).
  runId    String? @map("run_id")
  /// Null when the client reports before resolving a room.
  roomConfigId String? @map("room_config_id")

  /// Dotted name, e.g. 'anchor.translation_error_m',
  /// 'anchor.drift_m.20min', 'runtime.fps.p50'. Free-form on purpose;
  /// the vocabulary is documented, not enforced, so the partner can
  /// report something new without waiting on us to ship a migration.
  metric String
  value  Float
  /// 'm' | 'deg' | 'ms' | 'fps' | 'ratio' | 'count' — for display and to
  /// stop a centimetre being compared against a metre.
  unit   String

  /// Which device produced it. Drift is device-dependent, and a fleet
  /// average hides the one headset that is bad.
  deviceProfile String? @map("device_profile")
  deviceId      String? @map("device_id")

  /// Anything the client wants to keep: provider, tracking state,
  /// player count, phase of the encounter.
  context Json @default("{}")

  capturedAt DateTime @map("captured_at")
  createdAt  DateTime @default(now()) @map("created_at")

  source Source        @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  run    ExperienceRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([sourceId, metric, capturedAt])
  @@index([roomConfigId, metric])
  @@index([runId])
  @@map("spatial_metrics")
}
