// ============================================================
// PIK — Persistent Identity Kernel
// Prisma Schema for PostgreSQL (Railway)
// Sprint 6A: FateAccount layer added above RootIdentity
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// FATE ACCOUNTS — Top-level credential layer
// One FateAccount → many Heroes (RootIdentity, max 2)
// Auth: email+password | google | apple
// ============================================================

model FateAccount {
  id           String    @id @default(uuid()) @map("account_id")
  email        String?   @unique                          
  provider     String    @default("email")
  providerId   String?   @map("provider_id")
  passwordHash String?   @map("password_hash")
  displayName  String?   @map("display_name")
  status       String    @default("active")
  createdAt    DateTime  @default(now()) @map("created_at")
  lastLoginAt  DateTime? @map("last_login_at")

  heroes       RootIdentity[]
  sessions     AccountSession[]

  @@index([email])
  @@unique([provider, providerId])                        
  @@map("fate_accounts")
}

model AccountSession {
  id              String    @id @default(uuid()) @map("session_id")
  accountId       String    @map("account_id")
  tokenHash       String    @unique @map("token_hash")     // SHA-256 of raw token
  selectedHeroId  String?   @map("selected_hero_id")       // null = at hero select, set after hero chosen
  expiresAt       DateTime  @map("expires_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  account         FateAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  hero            RootIdentity? @relation(fields: [selectedHeroId], references: [id], onDelete: SetNull)

  @@index([tokenHash])
  @@index([accountId])
  @@map("account_sessions")
}

// ============================================================
// IDENTITY KERNEL — Hero records (one per character slot)
// Now owned by a FateAccount. Max 2 per account enforced in service.
// ============================================================

model RootIdentity {
  id            String    @id @default(uuid()) @map("root_id")
  fateAccountId String?   @map("fate_account_id")   // FK to FateAccount (nullable for legacy)
  heroName      String    @unique @map("hero_name")
  fateAlignment String    @default("NONE") @map("fate_alignment")
  origin        String?
  // Sprint 28 — single Fate XP per docs/canon/progression.md.
  // Drives Adventurer Rank and all content gates; combat power is
  // Resonance (gear-derived, computed, see § 3 of the canon).
  fateXp        Int       @default(0) @map("fate_xp")
  fateLevel     Int       @default(1) @map("fate_level")
  // Sprint 22.C — Job Class (selected at level 40, null until then)
  heroClass     String?   @map("hero_class")
  enrolledBy    String    @default("self") @map("enrolled_by")
  enrolledAt    DateTime  @default(now()) @map("enrolled_at")
  status        String    @default("active")
  equippedTitle String?   @map("equipped_title")
  // Sprint 31 — Reliquary Mark (Tier 2 cosmetic evolution). The
  // Reliquary is canon-universal (every hero wears one — economy.md
  // § 2). Mark is the player's first cosmetic-as-identity hook on
  // it. NULL = unmarked (default "plain-bound" silver). Validated
  // server-side against a known-Mark allowlist.
  relicMark     String?   @map("relic_mark")
  // Sprint 28 — Awakening narrative profile
  region                String?
  wound                 String?
  calling               String?
  virtue                String?
  vice                  String?
  awakeningCompletedAt  DateTime? @map("awakening_completed_at")
  // Sprint 28 — Expo push token (single token per hero in v1.0;
  // multi-device support is a separate push_devices table later).
  pushToken             String?   @map("push_token")
  pushUpdatedAt         DateTime? @map("push_updated_at")

  // Relations
  fateAccount   FateAccount?    @relation(fields: [fateAccountId], references: [id], onDelete: Cascade)
  activeSessions AccountSession[]
  personas      Persona[]
  keys          AuthKey[]
  sourceLinks   SourceLink[]
  events        IdentityEvent[]
  titles        UserTitle[]
  fateMarkers   FateMarker[]
  fateCaches    FateCache[]
  inventory     PlayerInventory[]
  equipment     PlayerEquipment[]
  challenges    WebAuthnChallenge[]
  sessions      PlayerSession[]
  wearables     IdentityToken[]
  quests        PlayerQuest[]
  dailyRites    DailyRite[]
  trainingEntries TrainingEntry[]
  pillarProgress  PillarProgress[]
  oaths           Oath[]
  nexus           PlayerNexus?
  components      PlayerComponents[]
  veilShards      VeilShard?
  tearEncounters  TearEncounter[]
  pityCounters      PityCounter[]
  warbandMemberships WarbandMembership[]
  sentInvites        WarbandInvite[]     @relation("InviteSender")
  foundedWarbands    Warband[]
  convergenceContributions ConvergenceContribution[]
  landmarkDiscoveries      LandmarkDiscovery[]         // Sprint 25
  sanctumState             SanctumState?               // Sprint 28 — iOS daily ritual
  iapPurchases             IapPurchase[]               // Sprint 28 — iOS IAP transactions
  fateFox                  FateFox?                    // Sprint 31 — Fate Fox companion (one per hero)
  memoria                  PlayerMemoria[]             // Sprint 32 — Memoria identity-collection
  sealedTears              WorldTear[]                 // Sprint 29 — Arc B geo-aware rifts
  // Sprint 33 — The Forge (gym / workout companion)
  forgeExercises           ForgeExercise[]             // custom movements authored by this hero
  forgeRegimens            ForgeRegimen[]              // saved routines / Forms
  forgeSessions            ForgeSession[]              // logged workouts (Forge Rites)
  forgeRecords             ForgePersonalRecord[]       // bests / Feats

  @@index([fateAccountId])
  @@map("root_identities")
}

model Persona {
  id            String    @id @default(uuid()) @map("persona_id")
  rootId        String    @map("root_id")
  displayName   String    @map("display_name")
  metadata      Json?
  status        String    @default("active")
  createdAt     DateTime  @default(now()) @map("created_at")

  root          RootIdentity @relation(fields: [rootId], references: [id], onDelete: Cascade)

  @@index([rootId])
  @@map("personas")
}

// ============================================================
// AUTHENTICATION — Legacy WebAuthn (retained, not used by Codex PWA)
// ============================================================

model AuthKey {
  id              String    @id @default(uuid()) @map("key_id")
  rootId          String    @map("root_id")
  credentialId    String    @unique @map("credential_id")
  publicKey       Bytes     @map("public_key")
  counter         BigInt    @default(0)
  deviceType      String?   @map("device_type")
  backedUp        Boolean   @default(false)
  transports      String[]  @default([])
  friendlyName    String?   @map("friendly_name")
  status          String    @default("active")
  createdAt       DateTime  @default(now()) @map("created_at")
  revokedAt       DateTime? @map("revoked_at")
  lastUsedAt      DateTime? @map("last_used_at")

  root            RootIdentity @relation(fields: [rootId], references: [id], onDelete: Cascade)

  @@index([rootId, status])
  @@map("auth_keys")
}

model WebAuthnChallenge {
  id          String    @id @default(uuid())
  rootId      String?   @map("root_id")
  challenge   String    @unique
  type        String
  metadata    Json?
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  root        RootIdentity? @relation(fields: [rootId], references: [id], onDelete: Cascade)

  @@index([challenge])
  @@index([expiresAt])
  @@map("webauthn_challenges")
}

// Legacy session tokens — kept for operator impersonation compatibility
model SessionToken {
  id          String    @id @default(uuid()) @map("token_id")
  rootId      String    @map("root_id")
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([tokenHash])
  @@index([expiresAt])
  @@map("session_tokens")
}

// ============================================================
// WEARABLE BRIDGE
// ============================================================

model IdentityToken {
  id          String    @id @default(uuid()) @map("token_id")
  rootId      String    @map("root_id")
  tokenType   String    @map("token_type")
  tokenUid    String    @unique @map("token_uid")
  friendlyName String?  @map("friendly_name")
  status      String    @default("active")
  issuedAt    DateTime  @default(now()) @map("issued_at")
  expiresAt   DateTime? @map("expires_at")
  lastTapAt   DateTime? @map("last_tap_at")
  tapCount    Int       @default(0) @map("tap_count")
  metadata    Json?

  root        RootIdentity @relation(fields: [rootId], references: [id], onDelete: Cascade)

  @@index([rootId])
  @@index([status])
  @@map("identity_tokens")
}

// ============================================================
// CONSENT — Sources and source links
// ============================================================

model Source {
  id          String    @id @map("source_id")
  name        String    @map("source_name")
  apiKeyHash  String    @map("api_key_hash")
  status      String    @default("active")
  sourceType  String    @default("venue") @map("source_type")
  createdAt   DateTime  @default(now()) @map("created_at")

  sourceLinks SourceLink[]
  fateCaches  FateCache[]

  @@map("sources")
}

model SourceLink {
  id          String    @id @default(uuid()) @map("link_id")
  rootId      String    @map("root_id")
  sourceId    String    @map("source_id")
  scope       String    @default("xp fate_markers titles")
  grantedBy   String    @map("granted_by")
  grantedAt   DateTime  @default(now()) @map("granted_at")
  revokedAt   DateTime? @map("revoked_at")
  revokedBy   String?   @map("revoked_by")
  status      String    @default("active")

  root        RootIdentity @relation(fields: [rootId], references: [id], onDelete: Cascade)
  source      Source       @relation(fields: [sourceId], references: [id])

  @@index([rootId, sourceId, status])
  @@map("source_links")
}

// ============================================================
// EVENT LEDGER — Append-only
// ============================================================

model IdentityEvent {
  id          String    @id @default(uuid()) @map("event_id")
  rootId      String    @map("root_id")
  eventType   String    @map("event_type")
  sourceId    String?   @map("source_id")
  payload     Json      @default("{}")
  changes     Json?     @map("changes_applied")
  createdAt   DateTime  @default(now()) @map("created_at")

  root        RootIdentity @relation(fields: [rootId], references: [id], onDelete: Cascade)

  @@index([rootId, createdAt])
  @@index([eventType])
  @@index([sourceId])
  @@map("identity_events")
}

// ============================================================
// PROGRESSION
// ============================================================

model Title {
  id            String    @id @map("title_id")
  displayName   String    @map("display_name")
  description   String?
  category      String?

  userTitles    UserTitle[]

  @@map("titles")
}

model UserTitle {
  id          String    @id @default(uuid())
  rootId      String    @map("root_id")
  titleId     String    @map("title_id")
  grantedAt   DateTime  @default(now()) @map("granted_at")
  sourceId    String?   @map("source_id")

  root        RootIdentity @relation(fields: [rootId], references: [id], onDelete: Cascade)
  title       Title        @relation(fields: [titleId], references: [id])

  @@unique([rootId, titleId])
  @@map("user_titles")
}

model FateMarker {
  id          String    @id @default(uuid())
  rootId      String    @map("root_id")
  marker      String
  sourceId    String?   @map("source_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  root        RootIdentity @relation(fields: [rootId], references: [id], onDelete: Cascade)

  @@index([rootId])
  @@map("fate_markers")
}

// ============================================================
// LOOT SYSTEM
// ============================================================

model LootTable {
  id          String  @id @default(uuid()) @map("loot_table_id")
  cacheType   String  @map("cache_type")
  rewardType  String  @map("reward_type")
  rewardValue String  @map("reward_value")
  displayName String  @map("display_name")
  weight      Int     @default(100)
  rarityTier  String  @default("common") @map("rarity_tier")
  minLevel    Int     @default(1) @map("min_level")

  @@index([cacheType])
  @@map("loot_table")
}

model FateCache {
  id           String    @id @default(uuid()) @map("cache_id")
  rootId       String    @map("root_id")
  cacheType    String    @map("cache_type")
  rarity       String    @default("common")
  sourceId     String?   @map("source_id")
  trigger      String?
  status       String    @default("sealed")
  grantedAt    DateTime  @default(now()) @map("granted_at")
  openedAt     DateTime? @map("opened_at")
  rewardType   String?   @map("reward_type")
  rewardValue  String?   @map("reward_value")
  rewardName   String?   @map("reward_name")
  rewardRarity String?   @map("reward_rarity")

  root   RootIdentity @relation(fields: [rootId], references: [id], onDelete: Cascade)
  source Source?      @relation(fields: [sourceId], references: [id])

  @@index([rootId])
  @@index([rootId, status])
  @@map("fate_caches")
}

// ============================================================
// GEAR SYSTEM
// ============================================================

model GearItem {
  id          String   @id @map("item_id")
  name        String   @map("display_name")
  slot        String
  rarityTier  String   @default("common") @map("rarity_tier")
  description String?
  loreText    String?  @map("lore_text")
  icon        String   @default("⚔")
  minLevel    Int      @default(1) @map("min_level")
  modifiers   Json     @default("{}")
  // Loot Sprint B — Phase 1 + 2A fields
  levelBand   String?  @map("level_band")
  regionTheme String?  @map("region_theme")
  itemFamily  String?  @map("item_family")
  loreTags    String[] @default([]) @map("lore_tags")
  itemPower   Int?     @map("item_power")
  slotBudget  Int?     @map("slot_budget")
  baseItemId  String?  @map("base_item_id")

  inventory   PlayerInventory[]

  @@index([slot])
  @@index([rarityTier])
  @@index([levelBand])
  @@index([regionTheme])
  @@map("gear_items")
}

model PlayerInventory {
  id          String    @id @default(uuid()) @map("inventory_id")
  rootId      String    @map("root_id")
  itemId      String    @map("item_id")
  acquiredVia String    @default("cache") @map("acquired_via")
  acquiredAt  DateTime  @default(now()) @map("acquired_at")

  root        RootIdentity   @relation(fields: [rootId], references: [id], onDelete: Cascade)
  item        GearItem       @relation(fields: [itemId], references: [id])
  equipment   PlayerEquipment?

  @@index([rootId])
  @@map("player_inventory")
}

model PlayerEquipment {
  id          String    @id @default(uuid()) @map("equipment_id")
  rootId      String    @map("root_id")
  slot        String
  inventoryId String    @unique @map("inventory_id")
  equippedAt  DateTime  @default(now()) @map("equipped_at")

  root        RootIdentity    @relation(fields: [rootId], references: [id], onDelete: Cascade)
  inventory   PlayerInventory @relation(fields: [inventoryId], references: [id])

  @@unique([rootId, slot])
  @@map("player_equipment")
}

// ============================================================
// SESSIONS
// ============================================================

model PlayerSession {
  id            String    @id @default(uuid()) @map("session_id")
  rootId        String    @map("root_id")
  sourceId      String    @map("source_id")
  zone          String?
  status        String    @default("active")
  checkedInAt   DateTime  @default(now()) @map("checked_in_at")
  lastHeartbeat DateTime  @default(now()) @map("last_heartbeat")
  checkedOutAt  DateTime? @map("checked_out_at")
  durationSec   Int?      @map("duration_sec")
  summary       Json?

  root   RootIdentity @relation(fields: [rootId], references: [id], onDelete: Cascade)

  @@index([rootId])
  @@index([status])
  @@index([sourceId, status])
  @@index([checkedInAt])
  @@map("player_sessions")
}

// ============================================================
// QUESTS
// ============================================================

model QuestTemplate {
  id          String    @id @default(uuid()) @map("quest_id")
  name        String
  description String?
  questType   String    @map("quest_type")
  objectives  Json
  rewards     Json
  minLevel    Int       @default(1) @map("min_level")
  maxLevel    Int?      @map("max_level")
  sourceId    String?   @map("source_id")
  sortOrder   Int       @default(0) @map("sort_order")
  status      String    @default("active")
  createdAt   DateTime  @default(now()) @map("created_at")

  playerQuests PlayerQuest[]

  @@index([status])
  @@index([questType])
  @@map("quest_templates")
}

model PlayerQuest {
  id          String    @id @default(uuid()) @map("player_quest_id")
  rootId      String    @map("root_id")
  questId     String    @map("quest_id")
  status      String    @default("active")
  progress    Json      @default("[]")
  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")

  root     RootIdentity  @relation(fields: [rootId], references: [id], onDelete: Cascade)
  quest    QuestTemplate @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([rootId, questId])
  @@index([rootId, status])
  @@index([questId])
  @@map("player_quests")
}

// ============================================================
// CONFIG
// ============================================================

model Config {
  key         String    @id @map("config_key")
  value       String    @map("config_value")
  description String?
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("config")
}

// ============================================================
// TRAINING SYSTEM
// ============================================================
// Pool of rite templates drawn from when generating daily rites.
// Seeded once — operator can add more over time.
model RiteTemplate {
  id          String  @id @default(uuid()) @map("rite_template_id")
  pillar      String                        // forge | lore | veil
  title       String                        // "Complete 20 min of cardio"
  description String?                       // Flavour text
  loreText    String? @map("lore_text")     // In-world framing
  xpBase      Int     @default(50) @map("xp_base")
  difficulty  String  @default("standard")  // easy | standard | hard
  status      String  @default("active")    // active | retired

  dailyRites  DailyRite[]

  @@index([pillar, status])
  @@map("rite_templates")
}

// A hero's generated daily rites for a specific date.
// Created on first GET /api/training/daily/:rootId for that day.
model DailyRite {
  id           String    @id @default(uuid()) @map("daily_rite_id")
  rootId       String    @map("root_id")
  templateId   String    @map("template_id")
  dateKey      String    @map("date_key")      // "2026-03-08" UTC date string
  pillar       String                           // forge | lore | veil (denorm for query speed)
  status       String    @default("pending")   // pending | completed | skipped
  completedAt  DateTime? @map("completed_at")
  xpGranted    Int?      @map("xp_granted")    // Set on completion

  root         RootIdentity  @relation(fields: [rootId], references: [id], onDelete: Cascade)
  template     RiteTemplate  @relation(fields: [templateId], references: [id])

  @@unique([rootId, dateKey, pillar])           // One rite per pillar per day
  @@index([rootId, dateKey])
  @@map("daily_rites")
}

// Individual training log entries (the Chronicle).
model TrainingEntry {
  id           String    @id @default(uuid()) @map("entry_id")
  rootId       String    @map("root_id")
  pillar       String                           // forge | lore | veil
  activityType String    @map("activity_type")  // workout | cardio | sport | reading | writing | meditation | prayer | service | other
  durationMin  Int?      @map("duration_min")
  notes        String?
  xpGranted    Int       @default(0) @map("xp_granted")
  dailyRiteId  String?   @map("daily_rite_id")  // Linked rite if this was a rite completion
  createdAt    DateTime  @default(now()) @map("created_at")

  root         RootIdentity @relation(fields: [rootId], references: [id], onDelete: Cascade)

  @@index([rootId, createdAt])
  @@index([rootId, pillar])
  @@map("training_entries")
}

// Per-hero pillar XP tracking (separate from fate_xp).
model PillarProgress {
  id           String    @id @default(uuid()) @map("pillar_progress_id")
  rootId       String    @map("root_id")
  pillar       String                           // forge | lore | veil
  xp           Int       @default(0)
  level        Int       @default(1)
  streak       Int       @default(0)            // Current day streak
  longestStreak Int      @default(0) @map("longest_streak")
  lastActivityAt DateTime? @map("last_activity_at")

  root         RootIdentity @relation(fields: [rootId], references: [id], onDelete: Cascade)

  @@unique([rootId, pillar])
  @@index([rootId])
  @@map("pillar_progress")
}

// Weekly oath declarations.
model Oath {
  id           String    @id @default(uuid()) @map("oath_id")
  rootId       String    @map("root_id")
  pillar       String                           // forge | lore | veil
  declaration  String                           // Free text — what they commit to
  weekOf       String    @map("week_of")        // ISO week start "2026-03-04"
  status       String    @default("pending")   // pending | kept | broken
  resolvedAt   DateTime? @map("resolved_at")
  xpGranted    Int?      @map("xp_granted")

  root         RootIdentity @relation(fields: [rootId], references: [id], onDelete: Cascade)

  @@unique([rootId, weekOf])                    // One oath per hero per week
  @@index([rootId, status])
  @@map("oaths")
}

// ============================================================
// SANCTUM (iOS) — Sprint 28
// In-app daily ritual state. One row per hero. Distinct from the
// legacy web rite/oath models above (different mechanics, different
// cadence, different resource economy). Rolls over by UTC date.
// ============================================================
model SanctumState {
  rootId             String    @id @map("root_id")
  veilEssence        Int       @default(0) @map("veil_essence")
  lastHearthClaim    String?   @map("last_hearth_claim")    // 'YYYY-MM-DD' UTC
  oathTodayDate      String?   @map("oath_today_date")       // 'YYYY-MM-DD' UTC
  oathTodayOption    String?   @map("oath_today_option")     // 'forge' | 'lore' | 'veil'
  totalHearthClaims  Int       @default(0) @map("total_hearth_claims")
  totalOathsSworn    Int       @default(0) @map("total_oaths_sworn")
  // Sprint 30 — daily Veil Trial (snackable 60s minigame).
  // last_trial_complete gates one-per-day, mirroring Hearth's pattern.
  lastTrialComplete  String?   @map("last_trial_complete")   // 'YYYY-MM-DD' UTC
  totalTrials        Int       @default(0) @map("total_trials")
  bestTrialScore     Int       @default(0) @map("best_trial_score")
  // Sprint 30 Slice 5.2 — daily Augury Draw (3-card weighted reveal).
  lastAuguryDate     String?   @map("last_augury_date")      // 'YYYY-MM-DD' UTC
  totalAuguries      Int       @default(0) @map("total_auguries")
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at")

  root         RootIdentity @relation(fields: [rootId], references: [id], onDelete: Cascade)

  @@map("sanctum_state")
}

// ============================================================
// FATE FOX — Sprint 31 / Tier 2 companion-bond
//
// Per docs/canon/progression.md § 6, every Awakened may bond one
// Fate Fox; the bond is permanent on both sides. Fox is a modifier
// layer — utility nudges (XP yield, cache rarity, etc.), NEVER
// combat power. v1 implements only the bond + a flat +5% Fate XP
// nudge; future slices add more modifier types + cosmetic skins.
//
// rootId is @unique because each hero bonds exactly one Fox for life.
// ============================================================
model FateFox {
  id        String   @id @default(uuid()) @map("fox_id")
  rootId    String   @unique @map("root_id")
  name      String
  bondedAt  DateTime @default(now()) @map("bonded_at")

  root      RootIdentity @relation(fields: [rootId], references: [id], onDelete: Cascade)

  @@map("fate_foxes")
}

// ============================================================
// MEMORIA — Sprint 32 Tier 2 identity-collection axis
//
// Each Memoria is a kept moment: a breath, a coal, a whisker.
// Granted idempotently when the player crosses a defined
// identity threshold (Awakening, Fox bond, first rank-up, etc).
//
// Identity weight, not power. Memoria do not affect combat,
// XP, or rewards — they exist purely as the persistent record
// of who the hero has become.
//
// The grant trigger lives in code (MemoriaService) keyed by
// triggerKey; the DB stores the def's display metadata only.
// New Memoria ship via INSERT + a new resolver in the service.
// ============================================================
model Memoria {
  id           String   @id @map("memoria_id")     // slug, e.g. 'first_breath'
  name         String                                // 'THE FIRST BREATH'
  lore         String                                // one-or-two-line narrative, mythic register
  glyph        String                                // single char rendered on the collection grid
  accent       String                                // hex color for ring + Chronicle entry
  triggerKey   String   @map("trigger_key")         // matches a resolver in MemoriaService
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")

  grants       PlayerMemoria[]

  @@map("memoria_defs")
}

model PlayerMemoria {
  id            String   @id @default(uuid()) @map("player_memoria_id")
  rootId        String   @map("root_id")
  memoriaId     String   @map("memoria_id")
  grantedAt     DateTime @default(now()) @map("granted_at")
  // Pointer back to the IdentityEvent that triggered the grant, so
  // future surfaces (XR, lore zoom-ins) can re-link "you got this
  // BECAUSE…" without re-deriving from the ledger every time.
  sourceEventId String?  @map("source_event_id")

  root          RootIdentity @relation(fields: [rootId], references: [id], onDelete: Cascade)
  memoria       Memoria      @relation(fields: [memoriaId], references: [id], onDelete: Cascade)

  @@unique([rootId, memoriaId])
  @@index([rootId])
  @@map("player_memoria")
}

// ============================================================
// AUGURY CARDS — Sprint 31 modular content-injection
//
// The daily Augury Draw deck. Lives in the DB so new cards (and
// seasonal cards, A/B test weights, rebalancing) ship without a
// redeploy. Per memory:strategic_north_star.md, this is the
// platform-shaped move that lets the same architecture later host
// quest-of-the-week / event-of-the-month content.
// ============================================================
model AuguryCard {
  id          String   @id @map("card_id")    // 'wisp-fragment' — stable slug
  name        String                            // 'WISP FRAGMENT' (display)
  flavor      String                            // 'A pale wisp drifts past your fingers.'
  rarity      String                            // 'common' | 'uncommon' | 'rare' | 'epic' | 'legendary'
  weight      Int                               // weighted-random pick weight
  rewards     Json                              // { essence?, fate_xp?, cache? }
  active      Boolean  @default(true)           // disable without deleting
  // Seasonal flag — cards with season != null are only eligible
  // for draws during their named season (e.g. 'hallow'). NULL =
  // permanent deck. Adds zero overhead to base draws (NULL is the
  // default match).
  season      String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([active])
  @@index([season])
  @@map("augury_cards")
}

// ============================================================
// IAP (iOS) — Sprint 28
// One row per StoreKit 2 transaction. Idempotent on the Apple
// transactionId so double-network can't double-credit. Refund
// handling (Server Notifications V2) is post-v1.0; refundedAt
// stays null until that landing.
// ============================================================
model IapPurchase {
  id                  String    @id @default(uuid()) @map("iap_id")
  rootId              String    @map("root_id")
  sku                 String                                  // 'essence_small' | 'essence_pack' | 'essence_hoard'
  essenceGranted      Int       @map("essence_granted")
  appleTransactionId  String    @unique @map("apple_transaction_id")  // Apple's canonical transactionId
  appleEnvironment    String    @map("apple_environment")     // 'Sandbox' | 'Production'
  appleBundleId       String    @map("apple_bundle_id")
  status              String    @default("granted")            // granted | refunded | revoked
  refundedAt          DateTime? @map("refunded_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  root RootIdentity @relation(fields: [rootId], references: [id], onDelete: Cascade)

  @@index([rootId, createdAt])
  @@map("iap_purchases")
}

// ============================================================
// ECONOMY SYSTEM — Nexus currency + crafting components
// ============================================================
model PlayerNexus {
  id        String   @id @default(uuid()) @map("nexus_id")
  rootId    String   @unique @map("root_id")
  balance   Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  root RootIdentity @relation(fields: [rootId], references: [id], onDelete: Cascade)

  @@index([rootId])
  @@map("player_nexus")
}

model PlayerComponents {
  id            String   @id @default(uuid()) @map("component_id")
  rootId        String   @map("root_id")
  componentType String   @map("component_type")
  quantity      Int      @default(0)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  root RootIdentity @relation(fields: [rootId], references: [id], onDelete: Cascade)

  @@unique([rootId, componentType])
  @@index([rootId])
  @@map("player_components")
}

// ============================================================
// VEIL TEARS — Sprint 13
// ──────────────────────────────────────────────

// Per-hero Veil Shard currency balance.
// One row per hero, upserted on each victory.
model VeilShard {
  id        String       @id @default(uuid()) @map("shard_id")
  rootId    String       @unique @map("root_id")
  balance   Int          @default(0)
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at")

  root RootIdentity @relation(fields: [rootId], references: [id], onDelete: Cascade)

  @@map("veil_shards")
}

// Individual battle record — one row per encounter outcome.
model TearEncounter {
  id        String    @id @default(uuid()) @map("encounter_id")
  rootId    String    @map("root_id")
  tearType  String    @map("tear_type")   // minor | wander | dormant | double
  tearName  String    @map("tear_name")
  outcome   String                        // won | fled
  shards    Int       @default(0)
  lat       Float?                        // GPS coords for future map features
  lon       Float?
  createdAt DateTime  @default(now()) @map("created_at")

  root RootIdentity @relation(fields: [rootId], references: [id], onDelete: Cascade)

  @@index([rootId, createdAt])
  @@index([rootId, outcome])
  @@map("tear_encounters")
}

// ============================================================
// PHASE 2 — Convergence Events
// ============================================================

// Active time-limited world events that boost rewards or alter spawns.
// Checked on every encounter — applied automatically by veil.service.
model ConvergenceEvent {
  id                  String   @id @default(uuid()) @map("event_id")
  name                String
  description         String?
  flavorText          String?  @map("flavor_text")
  affectedTiers       String[] @map("affected_tiers")
  shardMultiplier     Float    @default(1.0) @map("shard_multiplier")
  cacheBonus          Boolean  @default(false) @map("cache_bonus")
  startsAt            DateTime @map("starts_at")
  endsAt              DateTime @map("ends_at")
  status              String   @default("active")
  createdAt           DateTime @default(now()) @map("created_at")
  // Sprint 24 — global contribution tracking
  contributionCount   Int      @default(0) @map("contribution_count")
  targetCount         Int      @default(10000) @map("target_count")

  contributions       ConvergenceContribution[]

  @@index([status, endsAt])
  @@map("convergence_events")
}

model ConvergenceContribution {
  id          String   @id @default(uuid())
  eventId     String   @map("event_id")
  rootId      String   @map("root_id")
  warbandId   String?  @map("warband_id")
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt @map("updated_at")

  event       ConvergenceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  hero        RootIdentity     @relation(fields: [rootId], references: [id], onDelete: Cascade)

  @@unique([eventId, rootId])
  @@index([eventId])
  @@index([rootId])
  @@map("convergence_contributions")
}

model BaseItem {
  id            String   @id
  name          String
  slot          String
  levelMin      Int      @map("level_min")
  levelMax      Int      @map("level_max")
  levelBand     String   @map("level_band")
  regionTheme   String   @map("region_theme")
  itemFamily    String   @map("item_family")
  rarityAllowed String[] @map("rarity_allowed")
  pre40Only     Boolean  @default(true) @map("pre40_only")
  loreTags      String[] @default([]) @map("lore_tags")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([slot, levelBand])
  @@index([regionTheme])
  @@map("base_items")
}

model PityCounter {
  id        String   @id @default(uuid())
  rootId    String   @map("root_id")
  pityType  String   @map("pity_type")
  counter   Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  root      RootIdentity @relation(fields: [rootId], references: [id], onDelete: Cascade)

  @@unique([rootId, pityType])
  @@index([rootId])
  @@map("pity_counters")
}

model Warband {
  id           String   @id @default(uuid())
  name         String
  emblem       String   @default("⚔")
  alignment    String   @default("NONE")      // PRIMARY alignment — open to others
  reputation   Int      @default(0)
  foundedAt    DateTime @default(now()) @map("founded_at")
  founderRootId String  @map("founder_root_id")

  members      WarbandMembership[]
  invites      WarbandInvite[]
  founder      RootIdentity @relation(fields: [founderRootId], references: [id], onDelete: Cascade)

  @@index([alignment])
  @@index([reputation])
  @@map("warbands")
}

model WarbandMembership {
  id              String   @id @default(uuid())
  warbandId       String   @map("warband_id")
  rootId          String   @map("root_id")
  rank            String   @default("MEMBER")  // FOUNDER | OFFICER | MEMBER
  alignmentBonus  Boolean  @default(false) @map("alignment_bonus")
  joinedAt        DateTime @default(now()) @map("joined_at")

  warband         Warband      @relation(fields: [warbandId], references: [id], onDelete: Cascade)
  hero            RootIdentity @relation(fields: [rootId], references: [id], onDelete: Cascade)

  @@unique([warbandId, rootId])
  @@index([rootId])
  @@index([warbandId])
  @@map("warband_memberships")
}

model WarbandInvite {
  id              String   @id @default(uuid())
  warbandId       String   @map("warband_id")
  invitedByRootId String   @map("invited_by_root_id")
  inviteCode      String   @unique @map("invite_code")
  status          String   @default("pending")  // pending | accepted | expired
  expiresAt       DateTime @map("expires_at")
  createdAt       DateTime @default(now()) @map("created_at")

  warband         Warband      @relation(fields: [warbandId], references: [id], onDelete: Cascade)
  invitedBy       RootIdentity @relation("InviteSender", fields: [invitedByRootId], references: [id], onDelete: Cascade)

  @@index([inviteCode])
  @@index([warbandId])
  @@map("warband_invites")
}

// ============================================================
// LANDMARKS + LORE DISCOVERY — Sprint 25
// Tables created via POST /api/landmarks/bootstrap
// (bootstrap pattern — not prisma migrate execute)
// ============================================================

model Landmark {
  id               String   @id @map("landmark_id")
  name             String
  region           String
  tier             Int      @default(1)
  type             String   @default("public")   // hv_venue | public | operator
  lat              Float
  lon              Float
  radiusMeters     Int      @default(100) @map("radius_meters")
  isAutoRegistered Boolean  @default(false) @map("is_auto_registered")
  createdAt        DateTime @default(now()) @map("created_at")

  discoveries      LandmarkDiscovery[]

  @@index([region])
  @@map("landmarks")
}

model LandmarkDiscovery {
  id            String   @id @default(uuid()) @map("discovery_id")
  heroId        String   @map("hero_id")
  landmarkId    String   @map("landmark_id")
  fragmentIndex Int      @map("fragment_index")   // 1 | 2 | 3
  discoveredAt  DateTime @default(now()) @map("discovered_at")

  hero          RootIdentity @relation(fields: [heroId], references: [id], onDelete: Cascade)
  landmark      Landmark     @relation(fields: [landmarkId], references: [id], onDelete: Cascade)

  @@unique([heroId, landmarkId, fragmentIndex])
  @@index([heroId])
  @@index([landmarkId])
  @@map("landmark_discoveries")
}

// ============================================================
// WORLD TEARS — Sprint 29 / Arc B
// Geo-aware rifts seeded across real-world cities. The iOS Map
// screen swaps procedural spawnTears for /api/veil/tears/nearby
// queries against this table. Tier maps 1:1 to client tear type
// (T1 minor, T2 wander, T3 dormant, T4 double).
//
// Lifecycle (slice 3, not yet implemented):
//   spawned_at → active 24h → expires OR sealed by first hero.
//
// Indexes are a coarse bbox optimization; v2 wants postgis +
// gist for proper great-circle distance queries.
// ============================================================
model WorldTear {
  id              String    @id @default(uuid()) @map("tear_id")
  lat             Float
  lon             Float
  tier            String                                  // 'T1' | 'T2' | 'T3' | 'T4'
  status          String    @default("active")            // 'active' | 'sealed' | 'expired'
  spawnedAt       DateTime  @default(now()) @map("spawned_at")
  expiresAt       DateTime? @map("expires_at")
  sealedAt        DateTime? @map("sealed_at")
  sealedByRootId  String?   @map("sealed_by_root_id")
  regionLabel     String?   @map("region_label")          // e.g. 'folsom-ca', 'london-uk' — for analytics, not auth

  sealedBy        RootIdentity? @relation(fields: [sealedByRootId], references: [id], onDelete: SetNull)

  @@index([status, lat, lon])
  @@index([sealedByRootId])
  @@index([regionLabel, status])
  @@map("world_tears")
}

// ============================================================
// THE FORGE — Sprint 33
// Gym / workout companion (a Hevy/Strong-style logger) that
// tempers the body and feeds the Forge pillar + Fate XP. This is
// the Codex's body-tempering arm: a hero logs sets and reps, the
// Forge records the Feat, and the Chronicle remembers.
//
//   ForgeExercise        — movement library (global + custom)
//   ForgeRegimen         — saved routine / template ("Form")
//   ForgeRegimenExercise — an exercise slot within a regimen
//   ForgeSession         — a logged workout ("Forge Rite")
//   ForgeSessionExercise — an exercise performed in a session
//   ForgeSet             — a single set (weight × reps)
//   ForgePersonalRecord  — a hero's best for a movement (a "Feat")
// ============================================================

model ForgeExercise {
  id           String   @id @default(uuid()) @map("exercise_id")
  slug         String?  @unique                              // stable id for the global library; null for custom
  name         String                                        // "Barbell Bench Press"
  themeName    String?  @map("theme_name")                   // in-world flavour, e.g. "The Iron Press"
  category     String                                        // muscle group: chest | back | legs | shoulders | arms | core | cardio | other
  equipment    String   @default("barbell")                 // barbell | dumbbell | machine | cable | bodyweight | kettlebell | other
  logType      String   @default("weight_reps") @map("log_type") // weight_reps | reps | duration | distance
  instructions String?                                       // how-to / cue text
  isCustom     Boolean  @default(false) @map("is_custom")
  rootId       String?  @map("root_id")                      // owner for custom movements (null = global)
  status       String   @default("active")                  // active | retired
  createdAt    DateTime @default(now()) @map("created_at")

  root             RootIdentity?          @relation(fields: [rootId], references: [id], onDelete: Cascade)
  regimenSlots     ForgeRegimenExercise[]
  sessionExercises ForgeSessionExercise[]
  records          ForgePersonalRecord[]

  @@index([category, status])
  @@index([rootId])
  @@map("forge_exercises")
}

model ForgeRegimen {
  id         String   @id @default(uuid()) @map("regimen_id")
  rootId     String   @map("root_id")
  name       String                                          // "Push Day"
  themeTitle String?  @map("theme_title")                    // "The Sundering Form"
  notes      String?
  archived   Boolean  @default(false)
  orderIdx   Int      @default(0) @map("order_idx")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  root      RootIdentity           @relation(fields: [rootId], references: [id], onDelete: Cascade)
  exercises ForgeRegimenExercise[]
  sessions  ForgeSession[]

  @@index([rootId, archived])
  @@map("forge_regimens")
}

model ForgeRegimenExercise {
  id         String  @id @default(uuid()) @map("regimen_exercise_id")
  regimenId  String  @map("regimen_id")
  exerciseId String  @map("exercise_id")
  orderIdx   Int     @default(0) @map("order_idx")
  targetSets Int     @default(3) @map("target_sets")
  targetReps Int?    @map("target_reps")
  restSec    Int     @default(120) @map("rest_sec")
  notes      String?

  regimen  ForgeRegimen  @relation(fields: [regimenId], references: [id], onDelete: Cascade)
  exercise ForgeExercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@index([regimenId])
  @@map("forge_regimen_exercises")
}

model ForgeSession {
  id          String    @id @default(uuid()) @map("session_id")
  rootId      String    @map("root_id")
  regimenId   String?   @map("regimen_id")                   // source routine, if any
  name        String    @default("Forge Rite")
  status      String    @default("active")                  // active | completed | discarded
  notes       String?
  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")
  durationSec Int?      @map("duration_sec")
  totalVolume Int       @default(0) @map("total_volume")     // kg moved (sum of weight × reps)
  totalSets   Int       @default(0) @map("total_sets")
  totalReps   Int       @default(0) @map("total_reps")
  prCount     Int       @default(0) @map("pr_count")
  fateXp      Int       @default(0) @map("fate_xp")          // Fate XP granted on completion
  forgeXp     Int       @default(0) @map("forge_xp")         // Forge pillar XP granted

  root      RootIdentity           @relation(fields: [rootId], references: [id], onDelete: Cascade)
  regimen   ForgeRegimen?          @relation(fields: [regimenId], references: [id], onDelete: SetNull)
  exercises ForgeSessionExercise[]

  @@index([rootId, status])
  @@index([rootId, startedAt])
  @@map("forge_sessions")
}

model ForgeSessionExercise {
  id         String  @id @default(uuid()) @map("session_exercise_id")
  sessionId  String  @map("session_id")
  exerciseId String  @map("exercise_id")
  orderIdx   Int     @default(0) @map("order_idx")
  notes      String?

  session  ForgeSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise ForgeExercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  sets     ForgeSet[]

  @@index([sessionId])
  @@map("forge_session_exercises")
}

model ForgeSet {
  id                String  @id @default(uuid()) @map("set_id")
  sessionExerciseId String  @map("session_exercise_id")
  setNumber         Int     @map("set_number")
  weight            Float?                                   // kg
  reps              Int?
  durationSec       Int?    @map("duration_sec")
  distanceM         Int?    @map("distance_m")
  rpe               Float?                                   // rate of perceived exertion (1–10)
  isWarmup          Boolean @default(false) @map("is_warmup")
  completed         Boolean @default(false)
  isPr              Boolean @default(false) @map("is_pr")

  sessionExercise ForgeSessionExercise @relation(fields: [sessionExerciseId], references: [id], onDelete: Cascade)

  @@index([sessionExerciseId])
  @@map("forge_sets")
}

model ForgePersonalRecord {
  id         String   @id @default(uuid()) @map("record_id")
  rootId     String   @map("root_id")
  exerciseId String   @map("exercise_id")
  recordType String   @map("record_type")                   // max_weight | est_1rm | max_reps | best_duration | best_distance
  value      Float                                          // canonical numeric value of the record
  weight     Float?
  reps       Int?
  sessionId  String?  @map("session_id")
  achievedAt DateTime @default(now()) @map("achieved_at")

  root     RootIdentity  @relation(fields: [rootId], references: [id], onDelete: Cascade)
  exercise ForgeExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([rootId, exerciseId, recordType])
  @@index([rootId])
  @@map("forge_personal_records")
}
